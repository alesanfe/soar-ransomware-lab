{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOAR Ransomware Lab Alert Schema",
  "description": "JSON schema for validating ransomware detection alerts sent to Shuffle webhook",
  "type": "object",
  "required": [
    "alert_id",
    "hostname",
    "hash",
    "src_ip",
    "severity",
    "source",
    "detection_time",
    "event_type",
    "timestamp",
    "ip_address"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for the alert",
      "pattern": "^ALERT-[0-9]{4,8}-[0-9]{6}$"
    },
    "hostname": {
      "type": "string",
      "description": "Target hostname where the activity was detected",
      "minLength": 1,
      "maxLength": 255
    },
    "hash": {
      "type": "string",
      "description": "SHA256 hash of the suspicious file",
      "pattern": "^[a-fA-F0-9]{32,64}$"
    },
    "src_ip": {
      "type": "string",
      "description": "Source IP address of the threat actor",
      "format": "ipv4"
    },
    "ip_address": {
      "type": "string",
      "description": "Alias for src_ip",
      "format": "ipv4"
    },
    "severity": {
      "type": "integer",
      "description": "Alert severity level (0=Low, 1=Medium, 2=High, 3=Critical)",
      "minimum": 0,
      "maximum": 3
    },
    "source": {
      "type": "string",
      "description": "Source system that generated the alert",
      "enum": [
        "siem-ransomware-detection",
        "siem-file-monitoring",
        "siem-network-monitoring",
        "edr-alert",
        "manual-report"
      ]
    },
    "detection_time": {
      "type": "string",
      "description": "Timestamp when the alert was detected (ISO 8601 format)",
      "format": "date-time"
    },
    "timestamp": {
      "type": "string",
      "description": "Alias for detection_time for compatibility",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "description": "Type of security event detected",
      "enum": [
        "ransomware_detection",
        "file_monitoring",
        "network_intrusion",
        "malware_execution",
        "suspicious_behavior"
      ]
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the alert",
      "minLength": 10,
      "maxLength": 1000
    },
    "affected_files": {
      "type": "array",
      "description": "List of affected file paths",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mitre_tactics": {
      "type": "array",
      "description": "MITRE ATT&CK tactics associated with the alert",
      "items": {
        "type": "string",
        "pattern": "^TA[0-9]{4}$"
      }
    },
    "mitre_techniques": {
      "type": "array",
      "description": "MITRE ATT&CK techniques associated with the alert",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}$"
      }
    },
    "mitre_attack": {
      "type": "object",
      "description": "MITRE ATT&CK details",
      "properties": {
        "tactics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "user_account": {
      "type": "string",
      "description": "User account associated with the activity",
      "minLength": 1,
      "maxLength": 100
    },
    "process_name": {
      "type": "string",
      "description": "Name of the suspicious process",
      "minLength": 1,
      "maxLength": 255
    },
    "command_line": {
      "type": "string",
      "description": "Command line arguments used by the process",
      "maxLength": 1000
    },
    "parent_process": {
      "type": "string",
      "description": "Parent process that spawned the suspicious process",
      "maxLength": 255
    },
    "file_size": {
      "type": "integer",
      "description": "Size of the suspicious file in bytes",
      "minimum": 0
    },
    "file_path": {
      "type": "string",
      "description": "Full path to the suspicious file",
      "minLength": 1,
      "maxLength": 1000
    },
    "network_connections": {
      "type": "array",
      "description": "Network connections established by the suspicious process",
      "items": {
        "type": "object",
        "required": [
          "dst_ip",
          "dst_port",
          "protocol"
        ],
        "properties": {
          "dst_ip": {
            "type": "string",
            "format": "ipv4"
          },
          "destination_ip": {
            "type": "string",
            "format": "ipv4"
          },
          "dst_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "destination_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "bytes_sent": {
            "type": "integer",
            "minimum": 0
          },
          "bytes_received": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "registry_changes": {
      "type": "array",
      "description": "Windows registry keys modified by the suspicious process",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detection_rules": {
      "type": "array",
      "description": "Detection rules that triggered the alert",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "integer",
      "description": "Confidence level of the detection (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "impact_assessment": {
      "type": "object",
      "description": "Assessment of the potential impact",
      "required": [
        "data_affected",
        "systems_affected",
        "business_impact",
        "recovery_time_estimate",
        "affected_hosts",
        "files_encrypted"
      ],
      "properties": {
        "data_affected": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "systems_affected": {
          "type": "integer",
          "minimum": 0
        },
        "affected_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_impact": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "recovery_time_estimate": {
          "type": "string",
          "maxLength": 50
        },
        "files_encrypted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "false_positive_indicators": {
      "type": "array",
      "description": "Indicators that suggest this might be a false positive",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "whitelist_status": {
      "type": "string",
      "description": "Whitelist status of the detected item",
      "enum": [
        "not_whitelisted",
        "pending_review",
        "confirmed_false_positive",
        "whitelisted"
      ]
    }
  },
  "additionalProperties": false
}
