+// Warm app servers (SHUFFLE_WARM_APPS): one long-lived app container per
+// image sharing this worker's netns, dispatched via HTTP instead of a
+// one-shot container per action. The ready channel is CLOSED once the
+// cold start resolves so every concurrent and subsequent caller unblocks
+// (a buffered send would be consumed by the first waiter only).
+type warmAppServer struct {
+	id    string
+	port  int
+	err   error
+	ready chan struct{}
+}
+
+var warmAppServers = map[string]*warmAppServer{}
+var warmAppMutex sync.Mutex
+var warmPrewarmOnce sync.Once
