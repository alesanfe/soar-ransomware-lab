{
  "uid": "soar-e2e-quality",
  "title": "E2E Quality Gate",
  "tags": [
    "soar",
    "e2e",
    "quality",
    "o-02"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest run: TCs passed",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch"
          },
          "query": "metric_type:\"e2e_run\"",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "passed_tcs"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "metric_type",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_term"
              }
            }
          ],
          "timeField": "@timestamp",
          "index": "e2e-history"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "description": "Number of test cases passed in the most recent e2e-history doc."
    },
