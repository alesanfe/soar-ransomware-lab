{
  "realm": "soar",
  "enabled": true,
  "displayName": "SOAR Ransomware Lab",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Full platform administration"
      },
      {
        "name": "soc-analyst-l2",
        "description": "Analyst with response capabilities"
      },
      {
        "name": "soc-analyst-l1",
        "description": "Triage, read-only alerts/cases"
      },
      {
        "name": "responder",
        "description": "Execute containment/remediation actions"
      },
      {
        "name": "auditor",
        "description": "Read-only access to all operational data"
      },
      {
        "name": "infra-operator",
        "description": "Operate infrastructure, no case data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "soar-proxy",
      "enabled": true,
      "publicClient": false,
      "secret": "__OIDC_CLIENT_SECRET__",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:8072/oauth2/callback",
        "https://localhost:8073/oauth2/callback",
        "http://localhost:8084/login/generic_oauth"
      ],
      "webOrigins": [
        "https://localhost:8072",
        "https://localhost:8073",
        "http://localhost:8084"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@soar.local",
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "__KC_ADMIN_USER_PASS__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin",
        "auditor"
      ],
      "requiredActions": ["CONFIGURE_TOTP"],
      "emailVerified": true
    },
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@soar.local",
      "firstName": "SOC",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "__KC_ANALYST_USER_PASS__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "soc-analyst-l2"
      ],
      "requiredActions": ["CONFIGURE_TOTP"],
      "emailVerified": true
    }
  ],
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 1800,
  "passwordPolicy": "length(8) and notUsername(undefined)"
}