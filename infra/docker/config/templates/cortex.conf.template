{
  "play": {
    "secret": "${CORTEX_SECRET}",
    "server": {
      "http": {
        "port": "disabled"
      },
      "https": {
        "port": ${CORTEX_HTTPS_PORT:-9443},
        "keyStore": {
          "path": "/opt/certs/cortex-keystore.jks",
          "password": "changeit",
          "type": "JKS"
        }
      }
    }
  },
  "search": {
    "uri": "${ELASTICSEARCH_URL:-https://elasticsearch:9200}",
    "user": "${ELASTIC_USERNAME:-elastic}",
    "password": "${ELASTIC_PASSWORD}",
    "index": "cortex",
    "keepalive": "1m",
    "pagesize": 50
  },
  "auth": {
    "provider": ["local", "key"],
    "method": {
      "basic": true,
      "key": true
    },
    "byKey": {
      "maxAge": "30 days"
    },
    "local": {
      "autoCreateAdmin": true
    }
  },
  "job": {
    "timeout": 300,
    "maxConcurrentJobs": 10,
    "directory": "/tmp/cortex-jobs",
    "dockerDirectory": "${CORTEX_DOCKER_JOB_DIR}"
  },
  "http": {
    "port": "disabled",
    "host": "0.0.0.0"
  },
  "analyzer": {
    "urls": [
      "https://download.thehive-project.org/analyzers.json"
    ],
    "fork-join-executor": {
      "parallelism-min": 2,
      "parallelism-factor": 2.0,
      "parallelism-max": 4
    },
    "docker": {
      "network": "soar_net"
    }
  },
  "responder": {
    "urls": [
      "https://download.thehive-project.org/responders.json"
    ],
    "fork-join-executor": {
      "parallelism-min": 2,
      "parallelism-factor": 2.0,
      "parallelism-max": 4
    },
    "docker": {
      "network": "soar_net"
    }
  },
  "cache": {
    "job": "10 minutes",
    "user": "5 minutes",
    "organization": "5 minutes"
  }
}
