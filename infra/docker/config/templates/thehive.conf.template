# TheHive 5 configuration (HOCON). Rendered by scripts/setup/render_configs.py.
#
# Backend: JanusGraph + BerkeleyJE (embedded) + Lucene index — fully
# self-contained, no Elasticsearch dependency (unlike TheHive 3.x, which
# required the elastic4play join-field template hack).
play.http.secret.key = "${THEHIVE_SECRET}"

# TLS listener: lab CA-signed cert — internal callers verify against
# ca.crt (api/nginx/probes) or the JKS cacerts (JVM clients). The legacy
# HTTP listener is disabled — HTTPS :9443 only.
play.server.http.port = disabled
http.port = disabled
play.server.https.port = ${THEHIVE_HTTPS_PORT:-9443}
play.server.https.keyStore {
  path = "/opt/certs/thehive-keystore.jks"
  password = "changeit"
  type = "JKS"
}

db.janusgraph {
  storage {
    backend = berkeleyje
    directory = /opt/thp/thehive/data/db
    berkeleyje.freeDisk = 200
  }
}

# Index backend: Elasticsearch over TLS — Lucene is UNSUPPORTED since
# TheHive 5.1. The image entrypoint generates db.janusgraph.index.search.*
# (backend/hostname/index-name/auth) from TH_* env vars; this include adds
# the SSL bits the entrypoint cannot express (lab CA truststore).
db.janusgraph {
  index.search {
    elasticsearch {
      ssl.enabled = true
      ssl.truststore.location = "/opt/certs/lab-cacerts.jks"
      ssl.truststore.storepassword = "changeit"
      ssl.truststore.password = "changeit"
    }
  }
}

storage {
  provider = localfs
  localfs.location = /opt/thp/thehive/files
}

# CORE-OBS-002: Kamon prometheus reporter — bundled in the image
# (io.kamon.kamon-prometheus_2.13). Serves app-level metrics (pekko/Play
# HTTP, actors, counters) on :9095 — internal soar_net scrape only.
kamon.prometheus {
  start-embedded-http-server = yes
  embedded-server {
    hostname = "0.0.0.0"
    port = 9095
  }
}

# The Cortex connector is generated by the image entrypoint from
# TH_CORTEX_HOSTNAMES / TH_CORTEX_PROTO / TH_CORTEX_PORT / TH_CORTEX_KEYS
# (see docker-compose.core.yml) — rotating CORTEX_API_KEY only requires
# recreating the thehive service, no file rewrite needed.
