server:
  http_listen_port: 9080

# Root FS is read-only under the hardened overlay — positions live on the
# /tmp tmpfs (ephemeral by design: a restart re-scans current logs).
positions:
  filename: /tmp/positions.yaml

clients:
  - url: ${LOKI_URL:-https://loki:3100}/loki/api/v1/push
    tls_config:
      ca_file: /etc/promtail/ca.crt

scrape_configs:
  - job_name: docker-logs
    docker_sd_configs:
      # OBS-EVAL-007: discovery + log tailing go through the restricted
      # docker-socket-proxy (CONTAINERS/INFO/PING whitelisted) — same
      # SOAR-012 pattern as api/cortex/orborus. No raw daemon socket.
      - host: tcp://docker-socket-proxy:2375
        refresh_interval: 5s
    relabel_configs:
      - source_labels: [ '__meta_docker_container_name' ]
        regex: '/(.*)'
        target_label: container
      - source_labels: [ '__meta_docker_container_log_path' ]
        regex: '/var/lib/docker/containers/([^/]+)/[^/]+'
        replacement: '$1'
        target_label: container_id
      - source_labels: [ '__meta_docker_container_name' ]
        regex: '(.*)_\\d+'
        target_label: service
      - source_labels: [ '__meta_docker_network_name' ]
        regex: '(.+)'
        target_label: network
      - source_labels: [ '__meta_docker_container_label_com_docker_compose_service' ]
        regex: '(.+)'
        target_label: compose_service
      - source_labels: [ '__meta_docker_container_label_com_docker_compose_project' ]
        regex: '(.+)'
        target_label: compose_project
    # Redact secrets that upstream images print in plain logs before
    # they reach Loki (MISP entrypoint echoes redis/admin creds at
    # boot; Shuffle logs webhook token in hook URLs). The raw docker
    # logs still contain them — see docs/10 residual risk.
    pipeline_stages:
      - replace:
          expression: "(?i)(auth=)[^\\s&]+"
          replace: "${1}<REDACTED>"
      - replace:
          expression: "(?i)((?:password|api.?key|admin key|secret|token)(?:\\D{0,25}?[\"'\\]]\\s*|\\s*[=:]\\s*))([A-Za-z0-9+/=_-]{8,})"
          replace: "${1}<REDACTED>"
      - replace:
          expression: "(/api/v1/hooks/)[A-Za-z0-9._~%-]+"
          replace: "${1}<REDACTED>"
      # OBS-070: HTTP header dumps — Authorization (Basic/Bearer/Token),
      # X-Api-Key and Cookie values must never reach Loki.
      - replace:
          expression: "(?i)(authorization[\"']?\\s*[:=]\\s*(?:basic|bearer|service-token|token)\\s+)([A-Za-z0-9+/=._~-]{8,})"
          replace: "${1}<REDACTED>"
      - replace:
          expression: "(?i)((?:x-?api-?key|x-?service-?token)[\"']?\\s*[:=]\\s*)([A-Za-z0-9+/=._~-]{8,})"
          replace: "${1}<REDACTED>"
      - replace:
          expression: "(?i)(cookie[\"']?\\s*[:=]\\s*)([^\\s;]+)"
          replace: "${1}<REDACTED>"

  # NOTE: a `system-logs` job scraping /var/log/** was removed — the path
  # resolves INSIDE the promtail container (no host mount exists), so it
  # only ever tailed image-build leftovers (apt/dpkg/faillog) and, under
  # the non-root uid, produced permission-denied noise. Host system logs
  # would need an explicit :ro mount to be meaningful.
