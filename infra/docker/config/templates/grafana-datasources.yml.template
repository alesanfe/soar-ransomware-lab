apiVersion: 1
datasources:
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: ${LOKI_URL:-http://loki:3100}
    jsonData:
      maxLines: 1000
      derivedFields:
        - name: TraceID
          matcherRegex: '"trace_id":\s*"?([0-9a-f]{32})"?'
          url: "$${__value.raw}"
          datasourceUid: tempo
    isDefault: true
    editable: true
  - name: Elasticsearch
    uid: elasticsearch
    type: elasticsearch
    access: proxy
    url: ${ELASTICSEARCH_URL:-http://elasticsearch:9200}
    jsonData:
      esVersion: "7.10.0"
      timeField: "@timestamp"
      index: "soar-metrics"
      maxConcurrentShardRequests: 5
      includeFrozen: false
    basicAuth: true
    basicAuthUser: ${ELASTIC_USERNAME:-elastic}
    secureJsonData:
      basicAuthPassword: ${ELASTIC_PASSWORD}
    editable: true
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: ${TEMPO_URL:-http://tempo:3200}
    editable: true
    jsonData:
      tracesToLogsV2:
        datasourceUid: loki
        spanStartTimeShift: "-5m"
        spanEndTimeShift: "5m"
        filterByTraceID: true
        customQuery: true
        query: '{container_name=~".+"} |~ `__trace_id__`'
      serviceMap:
        datasourceUid: tempo
  - name: SOAR API
    uid: soar-api
    type: marcusolsson-json-datasource
    access: proxy
    url: ${API_URL:-http://api:8000}
    jsonData:
      httpMethod: "GET"
    editable: true
