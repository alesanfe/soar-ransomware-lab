{
  "_comment": "TEMPLATE — %%VAR%% rendered by s3-entrypoint.sh from env at container start (OBS-012). admin = weed shell / manual ops. loki/tempo are per-component identities scoped to their own bucket via policyNames -> Resource ARNs (OBS-015): the loki key can only touch arn:aws:s3:::loki*, tempo likewise.",
  "identities": [
    {
      "name": "admin",
      "credentials": [
        { "accessKey": "%%S3_ADMIN_ACCESS_KEY%%", "secretKey": "%%S3_ADMIN_SECRET_KEY%%" }
      ],
      "actions": ["Admin", "Read", "Write", "List", "Tagging"]
    },
    {
      "name": "loki",
      "credentials": [
        { "accessKey": "%%LOKI_S3_ACCESS_KEY%%", "secretKey": "%%LOKI_S3_SECRET_KEY%%" }
      ],
      "actions": [],
      "policyNames": ["loki-bucket-only"]
    },
    {
      "name": "tempo",
      "credentials": [
        { "accessKey": "%%TEMPO_S3_ACCESS_KEY%%", "secretKey": "%%TEMPO_S3_SECRET_KEY%%" }
      ],
      "actions": [],
      "policyNames": ["tempo-bucket-only"]
    }
  ],
  "policies": [
    {
      "name": "loki-bucket-only",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:ListMultipartUploads", "s3:ListBucketMultipartUploads", "s3:AbortMultipartUpload"],
            "Resource": ["arn:aws:s3:::loki", "arn:aws:s3:::loki/*"]
          }
        ]
      }
    },
    {
      "name": "tempo-bucket-only",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:ListMultipartUploads", "s3:ListBucketMultipartUploads", "s3:AbortMultipartUpload"],
            "Resource": ["arn:aws:s3:::tempo", "arn:aws:s3:::tempo/*"]
          }
        ]
      }
    }
  ]
}
