# ==============================================================================
# SOAR Ransomware Lab - Vagrantfile
# Multi-machine: Ubuntu (SOAR stack) + Windows (víctima/generador de tráfico)
#
# Uso:
#   vagrant up               # Levanta ambas VMs
#   vagrant up soar-ubuntu   # Solo la VM SOAR
#   vagrant up victima-windows # Solo la VM Windows
#   vagrant ssh soar-ubuntu  # Acceder a la VM SOAR
#   vagrant rdp victima-windows # Acceder a la VM Windows
# ==============================================================================

SOAR_IP    = "192.168.56.10"
WINDOWS_IP = "192.168.56.20"

# Directorio raíz del repo (dos niveles arriba del directorio que contiene el Vagrantfile)
# __dir__ = directorio del Vagrantfile (infra/vagrant/), ../.. sube a la raíz del repo
REPO_ROOT = File.expand_path("../..", __dir__)

Vagrant.configure("2") do |config|

  # ────────────────────────────────────────────────────────────────────────────
  # VM 1: Ubuntu — Stack SOAR completo (Docker + todos los servicios)
  # ────────────────────────────────────────────────────────────────────────────
  config.vm.define "soar-ubuntu", primary: true do |ub|
    ub.vm.boot_timeout = 1800
    ub.vm.box     = "bento/ubuntu-22.04"
    ub.vm.hostname = "soar-ubuntu"

    # Red privada para comunicación con la VM Windows
    ub.vm.network "private_network", ip: SOAR_IP

    # Port forwarding para acceder desde el host
    # Nota: usar puertos distintos al stack Docker (80,443,8081,5001,8083,8084,8085,8086)
    ub.vm.network "forwarded_port", guest: 443,  host: 9443,  host_ip: "127.0.0.1"
    ub.vm.network "forwarded_port", guest: 80,   host: 9080,  host_ip: "127.0.0.1"
    ub.vm.network "forwarded_port", guest: 8081, host: 9081,  host_ip: "127.0.0.1"
    ub.vm.network "forwarded_port", guest: 5001, host: 9001,  host_ip: "127.0.0.1"

    # Sincronizar el repositorio completo dentro de la VM
    ub.vm.synced_folder REPO_ROOT, "/opt/soar-ransomware-lab",
      owner: "vagrant", group: "vagrant"

    # Recursos: Elasticsearch + todos los servicios necesitan memoria y disco
    ub.vm.provider "virtualbox" do |vb|
      vb.name   = ENV.fetch("SOAR_VM_NAME", "soar-ransomware-lab-ubuntu-v3")
      vb.memory = 12288
      vb.cpus   = 4
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      vb.customize ["modifyvm", :id, "--ioapic", "on"]
    end

    ub.vm.provider "vmware_desktop" do |vmw|
      vmw.memory = 8192
      vmw.cpus   = 4
    end

    # Provisioning
    ub.vm.provision "shell", path: "provision.sh"

    # Mensaje post-arranque
    ub.vm.post_up_message = <<~MSG
      ✅ SOAR Ubuntu VM lista
         Web Management : https://localhost:9443/
         TheHive        : https://localhost:9443/thehive/
         Cortex         : https://localhost:9443/cortex/
         Shuffle        : https://localhost:9081/
         Shuffle API    : http://localhost:9001/
         Wazuh Dashboard: no reenviado por defecto (añadir forwarded_port 15601 si es necesario)
         SOAR IP (red interna): #{SOAR_IP}
         Nota: puertos 9080/9081/9443/9001 para no colisionar con stack Docker local
    MSG
  end

  # ────────────────────────────────────────────────────────────────────────────
  # VM 2: Windows — Víctima + generador de tráfico ransomware
  # NOTA: VM Windows deshabilitada debido a problemas de compatibilidad:
  #   - StefanScherer/windows_2019: WinRM timeout incluso con 1 hora de boot
  #   - gusztavvargadr boxes: Incompatibles con VirtualBox 7.x
  #   - Hyper-V: Requiere ejecutar como admin
  # SOLUCIÓN: Usar simulador Python (simulate_alerts.py) en lugar de VM Windows
  # ────────────────────────────────────────────────────────────────────────────
  # config.vm.define "victima-windows" do |win|
  #   win.vm.boot_timeout     = 3600
  #   win.vm.box              = "StefanScherer/windows_2019"
  #   win.vm.box_version      = "2021.05.15"
  #   win.vm.hostname         = "victima-windows"
  #   win.vm.communicator     = "winrm"
  #   win.winrm.username      = "vagrant"
  #   win.winrm.password      = "vagrant"
  #
  #   # Red privada — misma subred que la Ubuntu
  #   win.vm.network "private_network", ip: WINDOWS_IP
  #
  #   # Sincronizar repo para acceder al código del simulador
  #   win.vm.synced_folder REPO_ROOT, "C:/vagrant",
  #     owner: "vagrant"
  #
  #   # Hyper-V provider (requiere admin y Hyper-V habilitado)
  #   win.vm.provider "hyperv" do |hv|
  #     hv.vmname     = "soar-ransomware-lab-windows"
  #     hv.memory     = 4096
  #     hv.cpus       = 2
  #     hv.enable_virtualization_extensions = true
  #     hv.linked_clone = true
  #   end
  #
  #   # VirtualBox provider (fallback - gusztavvargadr boxes no compatibles con VB 7.x)
  #   win.vm.provider "virtualbox" do |vb|
  #     vb.name   = "soar-ransomware-lab-windows"
  #     vb.memory = 6144
  #     vb.cpus   = 2
  #     vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  #     vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
  #     vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]
  #   end
  #
  #   # Provisioning PowerShell
  #   win.vm.provision "shell",
  #     path:       "provision-windows.ps1",
  #     privileged: true,
  #     powershell_elevated_interactive: false
  #
  #   win.vm.post_up_message = <<~MSG
  #     ✅ Windows VM (víctima) lista
  #        IP: #{WINDOWS_IP}
  #        Para simular ataque de ransomware:
  #          vagrant winrm -c "powershell C:\\simulate-attack.ps1" victima-windows
  #        O conéctate por RDP y ejecuta: C:\\simulate-attack.ps1
  #   MSG
  # end

end
