# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUILab2024Secure

# === Lab API (FastAPI) ===
API_LOG_LEVEL=DEBUG
API_AUTH_SECRET=ApiAuthSecretLab2024Secure

# === Security Tokens (SIEM/EDR/Firewall simulation) ===
SIEM_WEBHOOK_TOKEN=SiEMWebhookTokenLab2024Secure
EDR_SIM_TOKEN=EdrSimTokenLab2024Secure
FIREWALL_SIM_TOKEN=FirewallSimTokenLab2024Secure

# === SMTP (optional, for notifications) ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Playbook decision threshold ===
DECISION_SCORE_THRESHOLD=80

# === Webhook rate limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Cortex analyzers ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:8085,http://localhost:8086,http://localhost:8081,http://localhost

# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# LOG_FORMAT: json (structured, for Promtail→Loki) | text (human-readable)
LOG_FORMAT=json
# LOG_DIR: path for rotating log files; leave empty to log to console only
LOG_DIR=

# === Backups ===
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Docker resource limits (reduced for testing) ===
ELASTICSEARCH_CPU_LIMIT=1.0
ELASTICSEARCH_CPU_RESERVATION=0.5
ELASTICSEARCH_MEMORY_LIMIT=2G
ELASTICSEARCH_MEMORY_RESERVATION=1G
THEHIVE_CPU_LIMIT=1.0
THEHIVE_CPU_RESERVATION=0.5
THEHIVE_MEMORY_LIMIT=2G
THEHIVE_MEMORY_RESERVATION=1G
CORTEX_CPU_LIMIT=1.0
CORTEX_CPU_RESERVATION=0.5
CORTEX_MEMORY_LIMIT=2G
CORTEX_MEMORY_RESERVATION=1G
SHUFFLE_CPU_LIMIT=1.0
SHUFFLE_CPU_RESERVATION=0.5
SHUFFLE_MEMORY_LIMIT=2G
SHUFFLE_MEMORY_RESERVATION=1G
WAZUH_MANAGER_CPU_LIMIT=1.0
WAZUH_MANAGER_CPU_RESERVATION=0.5
WAZUH_MANAGER_MEMORY_LIMIT=1G
WAZUH_MANAGER_MEMORY_RESERVATION=512M
WAZUH_DASHBOARD_CPU_LIMIT=0.5
WAZUH_DASHBOARD_CPU_RESERVATION=0.25
WAZUH_DASHBOARD_MEMORY_LIMIT=512M
WAZUH_DASHBOARD_MEMORY_RESERVATION=256M

# === Docker images ===
SHUFFLE_FRONTEND_IMAGE=shuffler.io/frontend:1.3.0
SHUFFLE_BACKEND_IMAGE=shuffler.io/shuffle:1.3.0
ORBORUS_IMAGE=shuffler.io/orborus:1.3.0

# === External URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Development / Debug ===
DEBUG_MODE=true
VERBOSE_LOGGING=true
HOT_RELOAD=true
