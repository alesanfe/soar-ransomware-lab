# SOAR Ransomware Lab - Testing Environment Variables
# This file is used for running tests with specific test configurations
# Usage: make up ENV_FILE=.env.testing

# === Project ===
COMPOSE_PROJECT_NAME=soar-test

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=19000
CORTEX_HTTP_PORT=19001
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=15001
ELASTICSEARCH_PORT=19200
OPENSEARCH_PORT=19201
OPENSEARCH_DASHBOARDS_PORT=15602
REDIS_PORT=6379

# === Ports — SIEM / Observability ===
WAZUH_API_PORT=55100
WAZUH_EVENTS_PORT=15141
WAZUH_ENROLLMENT_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_INDEXER_PORT=9200
WAZUH_DASHBOARD_PORT=15601

# === Ports — Management ===
HTTP_PORT=80
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084

# === Elasticsearch ===
ELASTIC_USERNAME=elastic

ELASTIC_SECURITY_ENABLED=true
ES_JAVA_OPTS=-Xms1g -Xmx1g

# === OpenSearch (migration target) ===
