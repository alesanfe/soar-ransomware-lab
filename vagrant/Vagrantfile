
Vagrant.configure("2") do |config|
  # Ubuntu (SOAR)
  config.vm.define "soar-ubuntu" do |ub|
    ub.vm.box = "ubuntu/jammy64"
    ub.vm.hostname = "soar-ubuntu"
    ub.vm.network "private_network", ip: "192.168.56.10"
    ub.vm.provision "shell", path: "provision.sh"
  end

  # Windows (víctima) - placeholder, requiere box/licencia válida
  config.vm.define "victima-windows" do |win|
    win.vm.box = "gusztavvargadr/windows-10" # ejemplo; ajusta según licencia
    win.vm.hostname = "victima-windows"
    win.vm.network "private_network", ip: "192.168.56.20"
  end
end
