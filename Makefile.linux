PROJECT := soar
COMPOSE_FILES := -f infra/docker/compose/docker-compose.yml \
                 -f infra/docker/compose/docker-compose.core.yml \
                 -f infra/docker/compose/docker-compose.misp.yml \
                 -f infra/docker/compose/docker-compose.api.yml \
                 -f infra/docker/compose/docker-compose.opensearch.yml \
                 -f infra/docker/compose/logging/docker-compose.logging.yml
export RUNTIME_DIR := $(CURDIR)/runtime
export REPORTS_DIR := $(CURDIR)/reports
DC := docker compose -p $(PROJECT) $(COMPOSE_FILES) --env-file .env
SIMULATE_N ?= 5
SIMULATE_DELAY ?= 3
SIEM_PYTHON ?= python3

.PHONY: help install install-dev
.PHONY: up down restart logs ps health
.PHONY: test-unit test-integration test-e2e test-atomic test-smoke test-security test-performance test-all test-coverage test-docker-runtime
.PHONY: test-e2e-report
.PHONY: test-e2e-tc01 test-e2e-tc01-01 test-e2e-tc01-02 test-e2e-tc01-03 test-e2e-tc01-04 test-e2e-tc01-05 test-e2e-tc01-06 test-e2e-tc01-07 test-e2e-tc01-08 test-e2e-tc01-09 test-e2e-tc01-10 test-e2e-tc01-11 test-e2e-tc02 test-e2e-tc02-01 test-e2e-tc02-02 test-e2e-tc02-03 test-e2e-tc02-04 test-e2e-tc02-05 test-e2e-tc03 test-e2e-tc03-01 test-e2e-tc04 test-e2e-tc04-01 test-e2e-tc04-02 test-e2e-tc04-03 test-e2e-tc04-04 test-e2e-tc04-05 test-e2e-tc04-06 test-e2e-tc04-07 test-e2e-tc04-08 test-e2e-tc05 test-e2e-tc05-01 test-e2e-tc05-02 test-e2e-tc05-03 test-e2e-tc05-04 test-e2e-tc06 test-e2e-tc06-01 test-e2e-tc06-02 test-e2e-tc07 test-e2e-tc07-01 test-e2e-tc07-02 test-e2e-tc07-03 test-e2e-tc07-04 test-e2e-tc07-05 test-e2e-tc08 test-e2e-tc08-01 test-e2e-tc08-02 test-e2e-tc08-03 test-e2e-tc08-04 test-e2e-tc09 test-e2e-tc09-01 test-e2e-tc09-02 test-e2e-tc09-03 test-e2e-tc09-04 test-e2e-tc09-05 test-e2e-tc09-06 test-e2e-tc09-07 test-e2e-tc10 test-e2e-tc10-01 test-e2e-tc10-02 test-e2e-tc10-03 test-e2e-tc10-04 test-e2e-tc10-05 test-e2e-tc10-06 test-e2e-tc10-07 test-e2e-tc11 test-e2e-tc11-01 test-e2e-tc11-02 test-e2e-tc11-03 test-e2e-tc11-04 test-e2e-tc11-05 test-e2e-tc11-06 test-e2e-tc11-07 test-e2e-tc11-08 test-e2e-tc11-09 test-e2e-tc11-10 test-e2e-tc11-11 test-e2e-tc11-12 test-e2e-tc11-13 test-e2e-tc12 test-e2e-tc12-01 test-e2e-tc12-02 test-e2e-tc12-03 test-e2e-tc12-04 test-e2e-tc12-05 test-e2e-tc12-06 test-e2e-tc12-07 test-e2e-tc12-08 test-e2e-tc12-09 test-e2e-tc12-10 test-e2e-tc13 test-e2e-tc13-01 test-e2e-tc13-02 test-e2e-tc13-03 test-e2e-tc13-04 test-e2e-tc13-05 test-e2e-tc13-06 test-e2e-tc13-07 test-e2e-tc13-08 test-e2e-tc13-09 test-e2e-tc13-10 test-e2e-tc13-11 test-e2e-tc13-12 test-e2e-tc13-13 test-e2e-tc14 test-e2e-tc14-01 test-e2e-tc14-02 test-e2e-tc14-03 test-e2e-tc14-04 test-e2e-tc14-05 test-e2e-tc14-06 test-e2e-tc14-07 test-e2e-tc15 test-e2e-tc15-01 test-e2e-tc15-02 test-e2e-tc15-03 test-e2e-tc15-04 test-e2e-tc15-05 test-e2e-tc15-06 test-e2e-tc16 test-e2e-tc16-01 test-e2e-tc16-02 test-e2e-tc16-03 test-e2e-tc17 test-e2e-tc17-01 test-e2e-tc17-02 test-e2e-tc17-03 test-e2e-tc17-04 test-e2e-tc17-05 test-e2e-tc17-06 test-e2e-tc17-07 test-e2e-tc18 test-e2e-tc18-01 test-e2e-tc18-02 test-e2e-tc18-03 test-e2e-tc19 test-e2e-tc19-01 test-e2e-tc20 test-e2e-tc20-01 test-e2e-tc21 test-e2e-tc21-01 test-e2e-tc21-02 test-e2e-tc22 test-e2e-tc22-01 test-e2e-tc22-02 test-e2e-tc23 test-e2e-tc23-01 test-e2e-tc24 test-e2e-tc24-01 test-e2e-tc24-02 test-e2e-tc24-03 test-e2e-tc24-04 test-e2e-tc25 test-e2e-tc25-01 test-e2e-tc25-02 test-e2e-tc25-03 test-e2e-tc26 test-e2e-tc26-01 test-e2e-tc26-02 test-e2e-tc27 test-e2e-tc27-01 test-e2e-tc27-02 test-e2e-tc28 test-e2e-tc28-01 test-e2e-tc28-02 test-e2e-tc28-03 test-e2e-tc28-04 test-e2e-tc28-05 test-e2e-tc28-06 test-e2e-tc28-07 test-e2e-tc28-08 test-e2e-tc28-09 test-e2e-tc29 test-e2e-tc29-01 test-e2e-tc30 test-e2e-tc30-01 test-e2e-tc30-02 test-e2e-tc31 test-e2e-tc31-01 test-e2e-tc31-02 test-e2e-tc31-03 test-e2e-tc32 test-e2e-tc32-01 test-e2e-kpi-01 test-e2e-kpi-01-01 test-e2e-kpi-02 test-e2e-kpi-02-01 test-e2e-kpi-02-02 test-e2e-kpi-03 test-e2e-kpi-03-01 test-e2e-kpi-04 test-e2e-kpi-04-01 test-e2e-kpi-05 test-e2e-kpi-05-01 test-e2e-tc33 test-e2e-tc33-01 test-e2e-tc33-02 test-e2e-tc33-03 test-e2e-tc33-04 test-e2e-tc33-05 test-e2e-tc33-06 test-e2e-tc33-07 test-e2e-tc33-08 test-e2e-tc33-09 test-e2e-tc33-10 test-e2e-new-features
.PHONY: sync-src sync-tests
.PHONY: metrics backup restore
.PHONY: clean reset
.PHONY: certs deps deps-test deps-lint generate-secrets generate-iocs validate-credentials lint lint-fix docs-lint
.PHONY: quality mutation test-review holistic-review
.PHONY: logs-service dev-reload dev-shell dev-debug docs-build docs-serve
