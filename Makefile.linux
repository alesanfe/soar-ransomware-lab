.PHONY: init-webhook clean-shuffle clean-thehive

help:
	@echo "=========================================="
	@echo "  SOAR Ransomware Lab - Linux Makefile"
	@echo "=========================================="
	@echo ""
	@echo "[Service Management]"
	@echo "  make up            - Start all SOAR services (Docker stack)"
	@echo "  make down          - Stop services and remove volumes"
	@echo "  make restart       - Restart all services"
	@echo "  make logs          - View service logs (follow mode)"
	@echo "  make ps            - Show running containers status"
	@echo "  make health        - Check health of core services"
	@echo "  make init-webhook  - Initialize Shuffle webhook for alerts"
	@echo "  make clean-shuffle - Clean stale Shuffle executions (OpenSearch + workers)"
	@echo "  make clean-thehive - Delete old TheHive cases (prevents ES timeout)"
	@echo ""
	@echo "[Testing]"
	@echo "  make test-unit        - Run unit tests only (in Docker)"
	@echo "  make test-integration - Run integration tests (in Docker)"
	@echo "  make test-e2e         - Run all E2E tests (in Docker)"
	@echo "  make test-e2e-report  - Generate E2E report (MD+JSON+charts) from lab data"
	@echo "  make test-e2e-tcXX    - Run individual TC-XX (00-34, KPI)"
	@echo "  make test-atomic     - Run atomic operation tests (in Docker)"
	@echo "  make test-security   - Run security tests (in Docker)"
	@echo "  make test-performance- Run performance tests (in Docker)"
	@echo "  make test-all        - Run ALL tests (unit + integration + e2e) (in Docker)"
	@echo "  make test-coverage   - Run tests with coverage report (in Docker)"
	@echo ""
	@echo "[SIEM Simulation]"
	@echo "  make simulate            - Simulate ransomware attack (5 alerts)"
	@echo "  make simulate-malicious  - Send 1 malicious alert"
	@echo "  make simulate-benign     - Send 1 benign alert"
	@echo "  make simulate-batch N=10 - Send N alerts (default: 10)"
	@echo ""
	@echo "[Maintenance]"
	@echo "  make deps               - Install Python dependencies"
	@echo "  make deps-test          - Install test dependencies"
	@echo "  make deps-lint          - Install linter dependencies (ruff, black, isort, flake8, mypy)"
	@echo "  make generate-secrets   - Generate secure passwords/tokens"
	@echo "  make generate-iocs      - Generate simulated IOCs"
	@echo "  make certs              - Generate TLS certificates for Nginx"
	@echo "  make metrics            - Calculate KPIs from logs"
	@echo "  make backup             - Create backup of runtime data"
	@echo "  make restore            - Restore from backup (BACKUP=<name>)"
	@echo "  make validate-credentials - Validate credential synchronization"
	@echo "  make clean              - Clean temporary files (reports, runtime logs)"
	@echo "  make reset              - Full reset: destroy containers, volumes, networks + clean"
	@echo ""
	@echo "[Code Quality]"
	@echo "  make lint               - Run ALL linters: ruff + black + isort + flake8 + mypy + docs-lint"
	@echo "  make docs-lint          - Run doc linters (markdownlint, lychee, docs_quality) + generate docs"
	@echo "  make lint-fix           - Auto-fix code with ruff, black and isort"
	@echo "  make quality            - Run quality checks -> reports/quality/quality-summary.md"
	@echo "  make mutation           - Run mutation testing (mutmut) in Docker -> reports/mutmut/"
	@echo "  make test-review        - Test review report (7-dimension methodology) -> reports/test-review/"
	@echo "  make holistic-review    - Holistic Project Radar (5 layers, 15 dims) -> reports/holistic/"
	@echo ""
	@echo "[Quick Start]"
	@echo "  1. make up                    # Start SOAR stack"
	@echo "  2. make init-webhook          # Initialize webhook"
	@echo "  3. make simulate              # Test with sample alert"
	@echo "  4. make test-e2e-tc01         # Run malicious IOC tests"
	@echo ""
install:
	python3 -m pip install -e .

install-dev:
	python3 -m pip install -e ".[dev]"

# Service Management
validate-credentials:
	@echo "Validating credential synchronization..."
	@test -f .env.full || { echo "ERROR: .env.full not found. Please create it from .env.example" && exit 1; }
	@python3 src/soar_lab/infrastructure/validate_credentials.py

verify-digests:
	@echo "Verifying Docker image digests..."
	@python3 scripts/maintenance/verify_image_digests.py

verify-digests-write:
	@echo "Generating requirements-docker.lock with image digests..."
	@python3 scripts/maintenance/verify_image_digests.py --write

up:
	@echo "==> [1/19] Checking .env.full exists..."
	@if [ ! -f .env.full ]; then if [ -f .env.full.reset.bak ]; then mv -f .env.full.reset.bak .env.full; elif [ -f .env.example ]; then cp -f .env.example .env.full; else echo 'ERROR: .env.full and .env.example are missing'; exit 1; fi; fi
	@echo "==> [2/19] Generating .env.full and Grafana datasources from templates..."
	$(MAKE) generate-secrets
	@echo "==> [3/19] Generating local .env for Docker with project-local runtime and reports dirs..."
	@python3 -c "import pathlib; s=pathlib.Path('.env.full').read_text(encoding='utf-8'); r=str(pathlib.Path('runtime').resolve()); p=str(pathlib.Path('reports').resolve()); lines=[l for l in s.splitlines() if not l.startswith('RUNTIME_DIR=') and not l.startswith('REPORTS_DIR=') and not l.startswith('ARTIFACTS_DIR=')]; lines.append(f'ARTIFACTS_DIR={r}'); lines.append(f'RUNTIME_DIR={r}'); lines.append(f'REPORTS_DIR={p}'); pathlib.Path('.env').write_text('\n'.join(lines), encoding='utf-8')"
	@echo "==> [4/19] Verifying Docker image digests (non-blocking)..."
	-@python3 scripts/maintenance/verify_image_digests.py --env-file .env 2>/dev/null || echo "[INFO] Digest verification skipped"
	@echo "==> [5/19] Recreating Docker networks with compose labels..."
	-docker network rm soar_net logging_net ti_net 2>/dev/null || true
	docker network create --label "com.docker.compose.network=soar_net" --label "com.docker.compose.project=soar" soar_net
	docker network create --label "com.docker.compose.network=logging_net" --label "com.docker.compose.project=soar" logging_net
	docker network create --label "com.docker.compose.network=ti_net" --label "com.docker.compose.project=soar" ti_net
	@echo "==> [6/19] Creating required directories..."
	@mkdir -p runtime/data/elasticsearch runtime/data/thehive/files runtime/data/cortex runtime/data/shuffle/apps runtime/data/shuffle/files runtime/data/redis runtime/data/misp/db runtime/data/misp/files runtime/data/misp/configs runtime/data/misp/logs runtime/data/loki runtime/data/grafana runtime/data/grafana_db runtime/data/opensearch runtime/backups runtime/logs runtime/logs/nginx runtime/logs/misp runtime/results runtime/config reports/validation/results reports/coverage
	@echo "==> [7/19] Rendering Docker config files from templates..."
	@python scripts/setup/render_configs.py --env-file .env
	@echo "==> [8/19] Building and starting Docker containers..."
	$(DC) up -d --build
	@echo "==> [9/19] Configuring Elasticsearch index templates (replicas=0 for single-node)..."
	@docker exec soar_api python /app/scripts/setup/configure_es.py || { echo 'configure_es failed'; exit 1; }
	@echo "==> [10/19] Waiting for Cortex and TheHive to initialize..."
	@docker exec soar_api python /app/scripts/setup/reset_cortex.py --reset || { echo 'reset_cortex failed'; exit 1; }
	@ok=0; for i in 1 2 3; do reset=""; test $$i -eq 1 || reset="--reset"; echo "Attempt $$i/3..."; docker exec soar_api python /app/scripts/setup/init_thehive.py $$reset && ok=1 && break; echo "init_thehive failed, retrying in 15s..."; sleep 15; done; test $$ok -eq 1
	@echo "==> [11/19] Restoring service credentials from backup (if available)..."
	-docker exec soar_api python /app/scripts/setup/restore_credentials.py || echo [INFO] No credentials backup found or restoration failed
	@echo "==> [12/19] Running init_shuffle_webhook.py (installs apps + creates workflow)..."
	@ok=0; for i in 1 2 3; do echo "Attempt $$i/3..."; docker exec soar_api python /app/scripts/setup/init_shuffle_webhook.py && ok=1 && break; echo "init_shuffle_webhook failed, retrying in 30s..."; sleep 30; done; test $$ok -eq 1
	@docker exec soar_api python /app/scripts/setup/update_env_from_webhook.py
	@echo "==> [13/19] Copying webhook_info.json from container..."
	-docker cp soar_api:/app/reports/validation/results/webhook_info.json reports/validation/results/webhook_info.json 2>/dev/null || true
	@echo "==> [14/19] Rewriting host-facing URLs in webhook_info.json..."
	@python3 scripts/setup/rewrite_webhook_info.py
	-docker cp reports/validation/results/webhook_info.json soar_api:/app/reports/validation/results/webhook_info.json 2>/dev/null || true
	@echo "==> [15/19] Setting up Cortex analyzers and MISP IOCs..."
	-docker exec soar_api python /app/scripts/setup/setup_analyzers_and_iocs.py || echo [INFO] Analyzer/IOC setup completed with warnings
	@echo "==> [16/19] Setting up Grafana KPI dashboard..."
	-python3 scripts/setup/setup_grafana_kpis.py || echo [INFO] Grafana KPI setup completed with warnings
	@echo "==> [17/19] Fixing Shuffle organization users..."
	-docker exec soar_api python /app/scripts/setup/fix_org_users.py || echo [INFO] Org-user fix completed with warnings
	@echo ""
	@echo "==> [18/19] Refreshing Grafana to load updated datasources..."
	$(DC) up -d --no-deps --force-recreate grafana
	@echo "==> [19/19] Showing service access URLs..."
	@python3 scripts/setup/show_access.py

down:
	$(DC) down -v --remove-orphans
	@echo "Services stopped and volumes removed"

restart:
	$(DC) restart
	@echo "Services restarted"

logs:
	$(DC) logs -f

ps:
	$(DC) ps

health:
	@python3 scripts/setup/health_check.py
init-webhook:
	@echo "Initializing Shuffle webhook..."
	@docker ps | grep soar_shuffle_backend >/dev/null 2>&1 || { echo ERROR: Shuffle backend is not running. Start services with 'make up' first; exit 1; }
	docker exec soar_api python /app/scripts/setup/init_shuffle_webhook.py

clean-shuffle:
	@echo "Cleaning stale Shuffle executions from OpenSearch..."
	@docker ps | grep soar_api >/dev/null 2>&1 || { echo ERROR: soar_api is not running. Start services with 'make up' first; exit 1; }
	docker exec soar_api python /app/scripts/maintenance/clean_shuffle_executions.py
	@echo "Shuffle cleanup complete."

clean-thehive:
	@echo "Cleaning old TheHive cases..."
	@docker ps | grep soar_api >/dev/null 2>&1 || { echo ERROR: soar_api is not running. Start services with 'make up' first; exit 1; }
	docker exec soar_api python /app/scripts/maintenance/clean_thehive_cases.py
	@echo "TheHive cleanup complete."

reset:
	@echo "==> [0/12] Backing up .env.full so it survives the reset..."
	@if [ -f .env.full ]; then cp -f .env.full .env.full.reset.bak; fi
	@echo "==> [1/12] Preserving service credentials before reset..."
	-@docker ps | grep soar_api >/dev/null 2>&1 && docker exec soar_api python /app/scripts/setup/preserve_credentials.py && docker cp soar_api:/app/reports/validation/results/credentials_backup.json reports/validation/results/credentials_backup.json || echo [INFO] API container not running, skipping credential preservation
	@echo "==> [2/12] Stopping project stack and removing project volumes..."
	-$(DC) down -v --remove-orphans --timeout 30
	@echo "==> [3/12] Force-removing any leftover soar_* containers..."
	-@docker ps -aq --filter name=soar_ | xargs -r docker stop 2>/dev/null || true
	-@docker ps -aq --filter name=soar_ | xargs -r docker rm -f
	@echo "==> [4/12] Force-removing any leftover tenzir containers..."
	-@docker ps -aq --filter name=tenzir | xargs -r docker rm -f
	@echo "==> [5/12] Removing any leftover project Docker volumes..."
	-@docker volume ls -q | grep -E '^soar([_-]|-lab)' | xargs -r docker volume rm -f
	@echo "==> [6/12] Removing any leftover project Docker networks..."
	-@docker network ls --format '{{.Name}}' | grep -E '^(soar|logging_net$$|ti_net$$|edge_net$$)' | xargs -r docker network rm
	@echo "==> [7/12] Removing local runtime directories..."
	@rm -rf runtime/data runtime/logs runtime/backups runtime/results runtime/config runtime/temp
	@echo "==> [8/12] Removing local reports directories..."
	@rm -rf reports/validation/results reports/coverage
	@echo "==> [9/12] Removing .env and temporary build artifacts..."
	@rm -rf .env .env.full.reset.bak .coverage coverage.xml coverage.json htmlcov .pytest_cache
	@rm -f reports/validation/results/credentials_backup.json reports/validation/results/webhook_info.json
	@echo "==> [10/12] Verifying no soar_ containers remain..."
	@test -z "$$(docker ps -aq --filter name=soar_)"
	@echo "==> [11/12] Verifying no project volumes remain..."
	@test -z "$$(docker volume ls -q | grep -E '^soar([_-]|-lab)' || true)"
	@echo "==> [12/12] Reset complete. Run 'make up' to start fresh."

sync-src:
	@echo "src/ and pytest.ini are bind-mounted in docker-compose.api.yml — no sync needed"

sync-tests:
	@echo "tests/ is bind-mounted in docker-compose.api.yml — no sync needed"

test-unit: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/unit -v --cov=src/soar_lab --cov-report=term --cov-report=json:runtime/coverage/coverage.json --cov-report=html:artifacts/coverage/htmlcov --cov-report=xml:artifacts/coverage/coverage.xml --cov-fail-under=80
	-docker exec soar_api cp /app/runtime/coverage/coverage.json /app/reports/coverage/coverage.json 2>/dev/null || true

test-integration: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/integration -v -m 'requires_docker or not requires_docker'

test-e2e: clean-shuffle clean-thehive test-e2e-tc01 test-e2e-tc02 test-e2e-tc03 test-e2e-tc04 test-e2e-tc05 test-e2e-tc06 test-e2e-tc07 test-e2e-tc08 test-e2e-tc09 test-e2e-tc10 test-e2e-tc11 test-e2e-tc12 test-e2e-tc13 test-e2e-tc14 test-e2e-tc15 test-e2e-tc16 test-e2e-tc17 test-e2e-tc18 test-e2e-tc19 test-e2e-tc20 test-e2e-tc21 test-e2e-tc22 test-e2e-tc23 test-e2e-tc24 test-e2e-tc25 test-e2e-tc26 test-e2e-tc27 test-e2e-tc28 test-e2e-tc29 test-e2e-tc30 test-e2e-tc31 test-e2e-tc32 test-e2e-tc33 test-e2e-kpi-01 test-e2e-kpi-02 test-e2e-kpi-03 test-e2e-kpi-04 test-e2e-kpi-05
	@echo "All E2E tests completed. Generating report..."
	@$(MAKE) test-e2e-report
	@echo "All E2E tests completed. Report at reports/e2e/e2e_report.md"

test-e2e-report: sync-src
	@echo "Generating E2E test report (MD + JSON + charts)..."
	@mkdir -p reports/e2e
	@docker cp scripts/reports/generate_e2e_report.py soar_api:/app/scripts/reports/generate_e2e_report.py 2>/dev/null || true
	-@docker exec soar_api python3 /app/scripts/reports/generate_e2e_report.py --output-dir /app/reports/e2e
	-@docker cp soar_api:/app/reports/e2e/. reports/e2e/ 2>/dev/null || true
	@echo "E2E report generated at reports/e2e/e2e_report.md"

test-e2e-tc01: test-e2e-tc01-01 test-e2e-tc01-02 test-e2e-tc01-03 test-e2e-tc01-04 test-e2e-tc01-05 test-e2e-tc01-06 test-e2e-tc01-07 test-e2e-tc01-08 test-e2e-tc01-09 test-e2e-tc01-10 test-e2e-tc01-11
	@echo "TC-01: All subtests completed."

test-e2e-tc01-01: sync-src sync-tests
	@echo "Running TC-01 (1/11): test_malicious_alert_full_workflow_group_1..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-01/test_malicious.py::TestMaliciousAlert::test_malicious_alert_full_workflow_group_1" -v

test-e2e-tc01-02: sync-src sync-tests
	@echo "Running TC-01 (2/11): test_malicious_alert_full_workflow_group_2..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-01/test_malicious.py::TestMaliciousAlert::test_malicious_alert_full_workflow_group_2" -v

test-e2e-tc01-03: sync-src sync-tests
	@echo "Running TC-01 (3/11): test_malicious_alert_full_workflow_group_3..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-01/test_malicious.py::TestMaliciousAlert::test_malicious_alert_full_workflow_group_3" -v

test-e2e-tc01-04: sync-src sync-tests
	@echo "Running TC-01 (4/11): test_malicious_alert_full_workflow_group_4..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-01/test_malicious.py::TestMaliciousAlert::test_malicious_alert_full_workflow_group_4" -v

