test-e2e-new-features: sync-src sync-tests
	@echo "Running all new SOAR features tests..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-10 tests/e2e/TC-11 tests/e2e/TC-12 tests/e2e/TC-13 tests/e2e/TC-14 -v

test-atomic: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/atomic -v

test-smoke: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/integration/test_smoke.py -v

test-security: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/security -v

test-performance: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/performance -v

test-all: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/ -v -m 'requires_docker or not requires_docker'

test-coverage: sync-src sync-tests
	docker exec soar_api python3 -m pytest tests/ -m 'requires_docker or not requires_docker' --ignore=tests/e2e --cov=src/soar_lab --cov-report=html --cov-report=xml --cov-report=json:runtime/coverage/coverage.json --cov-report=term --cov-fail-under=80
	-@docker exec soar_api cp -r /app/htmlcov /app/reports/coverage/ 2>/dev/null
	-@docker exec soar_api cp /app/coverage.xml /app/reports/coverage/ 2>/dev/null
	-@docker exec soar_api cp /app/runtime/coverage/coverage.json /app/reports/coverage/coverage.json 2>/dev/null || true

test-docker-runtime:
	@echo "Running Docker runtime status tests..."
	@PYTHONPATH=src python3 -m pytest tests/integration/test_docker_runtime_status.py -v

metrics:
	@mkdir -p reports/validation/results
	PYTHONPATH=src ELASTICSEARCH_URL=http://localhost:8200 ELASTIC_USER=elastic python3 src/soar_lab/data/calc_kpis.py --output reports/validation/results/kpis.csv

simulate:
	PYTHONPATH=src $(SIEM_PYTHON) -m soar_lab.infrastructure.messaging.send_alert --type malicious --num-alerts $(SIMULATE_N) --delay $(SIMULATE_DELAY)

simulate-malicious:
	PYTHONPATH=src $(SIEM_PYTHON) -m soar_lab.infrastructure.messaging.send_alert --type malicious --single

simulate-benign:
	PYTHONPATH=src $(SIEM_PYTHON) -m soar_lab.infrastructure.messaging.send_alert --type benign --single

simulate-batch:
	PYTHONPATH=src $(SIEM_PYTHON) -m soar_lab.infrastructure.messaging.send_alert --type malicious --num-alerts $(or $(N),10) --delay $(SIMULATE_DELAY)

# Metrics & Backup
backup:
	@curl -sf http://localhost:8000/health >/dev/null 2>&1 || { echo "ERROR: API not available. Start services with 'make up' first" && exit 1; }
	curl -sf -X POST http://localhost:8000/backup/create -H "Content-Type: application/json" -d '{"backup_name":"manual-backup.tar.gz"}' | python3 -m json.tool

restore:
	@test "$(BACKUP)"="" && { echo "ERROR: BACKUP parameter required. Usage: make restore BACKUP=<backup_name>" && echo "Available backups:" && ls runtime/backups 2>/dev/null || echo "No backups found" && exit 1; }
	@test ! -f runtime/backups/$(BACKUP) && { echo "ERROR: Backup file runtime/backups/$(BACKUP) not found" && exit 1; }
	@curl -sf http://localhost:8000/health >/dev/null 2>&1 || { echo "ERROR: API not available. Start services with 'make up' first" && exit 1; }
	curl -sf -X POST http://localhost:8000/backup/restore -H "Content-Type: application/json" -d '{"backup_name":"$(BACKUP)"}' | python3 -m json.tool

deps:
	@echo "Installing Python dependencies..."
	python3 -m pip install -e .

deps-test:
	@echo "Installing test dependencies..."
	python3 -m pip install -e ".[dev,test]"

deps-lint:
	@echo "Installing linter dependencies (ruff, black, isort, flake8, mypy, vulture, bandit, radon)..."
	python3 -m pip install -e ".[dev]"
	python3 -m pip install ruff vulture bandit radon flake8-docstrings flake8-bandit flake8-bugbear flake8-comprehensions
	python3 -m pip install flake8-quotes flake8-isort flake8-mypy flake8-pytest-style pydoclint flake8-pyproject
	@echo "==> Linter dependencies installed!"

certs:
	@echo "Generating TLS certificates for Nginx..."
	@mkdir -p infra/docker/config/nginx/ssl
	@CERT_DIR=infra/docker/config/nginx/ssl bash scripts/setup/gen_certs.sh soar.local

generate-secrets:
	@echo "Generating .env.full and Grafana datasources from templates..."
	@python3 scripts/setup/generate_env.py

generate-iocs:
	@echo "Generating simulated IOCs..."
	@PYTHONPATH=src python3 -m soar_lab.interfaces.api.cli generate-iocs

clean:
	@rm -rf reports/validation/results reports/coverage .pytest_cache .coverage coverage.xml htmlcov

# Maintenance Commands
logs-service:
	@test "$(SERVICE)"="" && { echo "ERROR: SERVICE parameter required. Usage: make logs-service SERVICE=<service_name>" && exit 1; }
	@echo "Viewing logs for service: $(SERVICE)"
	$(DC) logs -f $(SERVICE)

# Development Commands
dev-reload: sync-src
	@echo "Reloading code in API container without rebuild..."
	$(DC) up -d --no-deps --force-recreate api

dev-shell:
	@echo "Opening shell in API container..."
	docker exec -it soar_api /bin/bash

dev-debug:
	@echo "Starting API in debug mode..."
	$(DC) up -d --no-deps --force-recreate api
	docker exec -it soar_api python -m debugpy --listen 0.0.0.0:5678 --wait-for-client -m uvicorn soar_lab.interfaces.api:app --host 0.0.0.0 --port 8000 --reload

# Documentation Commands
docs-build:
	@echo "Building documentation..."
	docker exec soar_api python -m sphinx -b html docs/ reports/docs/

docs-serve:
	@echo "Serving documentation at http://localhost:8001..."
	docker run -d -p 8001:8001 -v $(CURDIR)/reports/docs:/usr/share/nginx/html nginx:alpine


docs-lint:
	@echo "==> Running docs-lint (all doc linters + doc generation)..."
	@echo "  1. markdownlint"
	-@command -v markdownlint >/dev/null 2>&1 && markdownlint docs/ || echo "  markdownlint not installed, skipping"
	@echo "  2. link-checker (lychee)"
	-@command -v lychee >/dev/null 2>&1 && lychee --quiet docs/ || echo "  lychee not installed, skipping"
	@echo "  3. docs_quality.py (OpenAPI diff + banned patterns + test inventory)"
	python3 scripts/ci/docs_quality.py
	@echo "  4. pytest collect-only"
	python3 -m pytest --collect-only -q
	@echo "  5. Generate documentation (Sphinx HTML)"
	@mkdir -p reports/docs
	-@python3 -m sphinx -b html docs/ reports/docs/ 2>/dev/null || echo "  Sphinx not available locally, trying Docker..."
	-@docker ps | grep -q soar_api && docker exec soar_api python -m sphinx -b html docs/ reports/docs/ || echo "  Docker not running, skipping Sphinx build"
	@echo "==> docs-lint complete!"

# Code quality — single lint target runs ALL linters inline
lint:
	@echo ""
	@echo "=========================================================="
	@echo "  [1/6] Ruff — lint lógico (imports, unused, bugs)"
	@echo "=========================================================="
	@python3 -m ruff check src/ tests/ scripts/setup/
	@echo ""
	@echo "=========================================================="
	@echo "  [2/6] Black — formato de código (check only)"
	@echo "=========================================================="
	@python3 -m black --check src/ tests/
	@echo ""
	@echo "=========================================================="
	@echo "  [3/6] isort — orden de imports (check only)"
	@echo "=========================================================="
	@python3 -m isort --check-only src/ tests/
	@echo ""
	@echo "=========================================================="
	@echo "  [4/6] Flake8 — estilo + 60 plugins"
	@echo "=========================================================="
	@python3 -m flake8 src/ tests/
	@echo ""
	@echo "=========================================================="
	@echo "  [5/6] Mypy — type checker"
	@echo "=========================================================="
	@python3 -m mypy src/
	@echo ""
	@echo "=========================================================="
	@echo "  [6/6] docs-lint — linters de docs + generación"
	@echo "=========================================================="
	@echo "  1. markdownlint"
	-@command -v markdownlint >/dev/null 2>&1 && markdownlint docs/ || echo "  markdownlint not installed, skipping"
	@echo "  2. link-checker (lychee)"
	-@command -v lychee >/dev/null 2>&1 && lychee --quiet docs/ || echo "  lychee not installed, skipping"
	@echo "  3. docs_quality.py (OpenAPI diff + banned patterns + test inventory)"
	python3 scripts/ci/docs_quality.py
	@echo "  4. pytest collect-only"
	python3 -m pytest --collect-only -q
	@echo "  5. Generate documentation (Sphinx HTML)"
	@mkdir -p reports/docs
	-@python3 -m sphinx -b html docs/ reports/docs/ 2>/dev/null || echo "  Sphinx not available locally, trying Docker..."
	-@docker ps | grep -q soar_api && docker exec soar_api python -m sphinx -b html docs/ reports/docs/ || echo "  Docker not running, skipping Sphinx build"
	@echo ""
	@echo "=========================================================="
	@echo "  All linters passed!"
	@echo "=========================================================="

quality:
	@echo "==> Running quality checks (scripts/quality/)..."
	@mkdir -p reports/quality
	@if [ ! -f reports/coverage/coverage.xml ]; then echo "  Coverage XML not found, generating..."; python3 -m pytest tests/unit tests/atomic tests/architecture --cov=src/soar_lab --cov-branch --cov-report=xml:reports/coverage/coverage.xml --cov-report=json:reports/coverage/coverage.json -q --tb=no 2>/dev/null; fi
	@python3 scripts/quality/run_quality_checks.py --output-dir reports/quality
	@echo "==> Quality checks passed! Report at reports/quality/quality-summary.md"

mutation:
	@echo "==> Running mutation testing (mutmut) in Docker..."
	@echo "    This mutates src/soar_lab/ and runs tests for each mutant."
	@echo "    Estimated time: 60-180 min depending on hardware."
	@mkdir -p reports/mutmut
	@docker exec soar_api pip install --quiet mutmut 2>/dev/null || true
	@docker exec soar_api python scripts/reports/generate_mutmut_report.py --output-dir reports/mutmut
	@test -f reports/mutmut/mutation_report.md && echo "==> Mutation report generated: reports/mutmut/mutation_report.md" || (echo "==> Report not found. Check Docker container logs." && exit 1)

test-review:
	@echo "==> Generating test review report (7-dimension methodology)..."
	@mkdir -p reports/test-review
	@python3 scripts/reports/test_review.py --output-dir reports/test-review --with-coverage
	@echo "==> Test review report: reports/test-review/test_review_report.md"

holistic-review:
	@echo "==> Running Holistic Project Radar (5 layers, 15 dimensions)..."
	@mkdir -p reports/holistic
	@python3 scripts/reports/holistic_review.py --output-dir reports/holistic
	@echo "==> Holistic review report: reports/holistic/holistic_review_report.md"

lint-fix:
	@echo "==> Auto-fixing code with ruff, black and isort..."
	@python3 -m ruff check --fix src/ tests/ scripts/setup/
	@python3 -m ruff format src/ tests/ scripts/setup/
	@python3 -m black src/ tests/
	@python3 -m isort src/ tests/
	@echo "==> Lint fix complete!"
