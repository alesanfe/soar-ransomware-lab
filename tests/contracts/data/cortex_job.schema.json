{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cortex job document (cortex_6 index)",
  "type": "object",
  "required": ["status", "dataType", "workerName"],
  "properties": {
    "status": {"enum": ["Waiting", "InProgress", "Success", "Failure", "Deleted"]},
    "data": {"type": "string"},
    "dataType": {"type": "string"},
    "workerName": {"type": "string"},
    "workerId": {"type": "string"},
    "workerDefinitionId": {"type": "string"},
    "startDate": {"type": "integer"},
    "endDate": {"type": "integer"},
    "errorMessage": {"type": "string"},
    "message": {"type": "string"},
    "organization": {"type": "string"},
    "tlp": {"type": "integer"},
    "pap": {"type": "integer"}
  },
  "additionalProperties": true
}
