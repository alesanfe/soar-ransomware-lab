{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIEM alert payload (Shuffle webhook → workflow)",
  "type": "object",
  "required": ["alert_id", "timestamp", "severity"],
  "properties": {
    "alert_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string"},
    "timestamp": {"type": ["string", "number"]},
    "severity": {"type": ["integer", "string"]},
    "source": {"type": "string"},
    "hostname": {"type": "string"},
    "src_ip": {"type": "string", "description": "ip observable — may be empty string"},
    "domain": {"type": "string"},
    "url": {"type": "string"},
    "hash": {"type": "string", "description": "md5/sha1/sha256/sha512 — may be empty"},
    "alert_type": {"type": "string"},
    "event_type": {"type": "string"},
    "raw": {"type": "string"}
  },
  "additionalProperties": true
}
