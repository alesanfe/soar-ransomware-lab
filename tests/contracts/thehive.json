{
  "name": "thehive",
  "service_name": "thehive",
  "version": "5.0.0",
  "supported_versions": [
    "5.0.0"
  ],
  "deprecated_versions": [
    "1.0.0",
    "0.9.0"
  ],
  "deprecated_endpoints": {
    "/api/legacy/case": "Use /api/v1/case instead",
    "/api/case": "TheHive 3 API — use /api/v1/case (create) or POST /api/v1/query (list)",
    "/api/case/_search": "TheHive 3 API — use POST /api/v1/query",
    "/api/case/{id}/artifact": "TheHive 3 API — use /api/v1/case/{id}/observable"
  },
  "required_headers": [
    "Content-Type",
    "Authorization"
  ],
  "rate_limit": {
    "requests_per_minute": 100,
    "requests_per_hour": 5000,
    "requests_per_day": 50000
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string"
      },
      "message": {
        "type": "string"
      }
    }
  },
  "migration_guides": {
    "1.0.0->5.0.0": "TheHive 3.x /api/* endpoints moved to /api/v1/*; artifact became observable; list/search endpoints consolidated into POST /api/v1/query."
  },
  "endpoints": {
    "/api/v1/status": {
      "GET": {
        "response_schema": {
          "type": "object"
        }
      }
    },
    "/api/v1/case": {
      "POST": {
        "request_schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "severity": {
              "type": "integer"
            },
            "tags": {
              "type": "array"
            }
          }
        }
      }
    },
    "/api/v1/case/{id}": {
      "GET": {},
      "PATCH": {},
      "DELETE": {}
    },
    "/api/v1/case/{id}/observable": {
      "POST": {
        "request_schema": {
          "type": "object",
          "properties": {
            "dataType": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "tlp": {
              "type": "integer"
            },
            "ioc": {
              "type": "boolean"
            },
            "sighted": {
              "type": "boolean"
            },
            "tags": {
              "type": "array"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "/api/v1/case/{id}/task": {
      "POST": {}
    },
    "/api/v1/alert": {
      "POST": {}
    },
    "/api/v1/query": {
      "POST": {
        "request_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "array"
            }
          }
        },
        "response_schema": {
          "type": "array"
        }
      }
    },
    "/api/v1/user/current": {
      "GET": {}
    }
  }
}
