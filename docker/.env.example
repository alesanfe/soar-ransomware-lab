# SOAR Ransomware Lab - Environment Variables
# Copy this file to .env and adjust values before running docker-compose up

# === Project Configuration ===
COMPOSE_PROJECT_NAME=soar

# === Network Ports ===
THEHIVE_HTTP_PORT=9000
CORTEX_HTTP_PORT=9001
SHUFFLE_UI_PORT=3001
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=19200

# === Elasticsearch Configuration ===
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTIC_SECURITY_ENABLED=true
ELASTIC_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# === Shuffle Configuration ===
SHUFFLE_FRONTEND_IMAGE=shuffler.io/frontend:1.3.0
SHUFFLE_BACKEND_IMAGE=shuffler.io/shuffle:1.3.0
ORBORUS_IMAGE=shuffler.io/orborus:1.3.0
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>
SHUFFLE_DEFAULT_APIKEY=<GENERATE_STRONG_API_KEY_HERE>
DOCKER_API_VERSION=1.44

# === TheHive Configuration ===
THEHIVE_SECRET=<GENERATE_STRONG_SECRET_KEY_HERE>
THEHIVE_API_KEY=<GENERATE_STRONG_API_KEY_HERE>

# === Cortex Configuration ===
CORTEX_SECRET=<GENERATE_STRONG_SECRET_KEY_HERE>
CORTEX_API_KEY=<GENERATE_STRONG_API_KEY_HERE>

# === Security Tokens ===
SIEM_WEBHOOK_TOKEN=<GENERATE_STRONG_TOKEN_HERE>
EDR_SIM_TOKEN=<GENERATE_STRONG_TOKEN_HERE>
FIREWALL_SIM_TOKEN=<GENERATE_STRONG_TOKEN_HERE>

# === Decision Thresholds ===
DECISION_SCORE_THRESHOLD=80

# === Database Configuration ===
POSTGRES_USER=thehive
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>
POSTGRES_DB=thehive

# === Redis Configuration ===
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# === TLS Configuration ===
ENABLE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs/thehive.crt
TLS_KEY_PATH=/etc/ssl/private/thehive.key

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Performance Configuration ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === Rate Limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Health Check Configuration ===
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
