# SOAR Ransomware Lab Environment Variables
# Copy this file to .env and modify as needed

# Service Ports
THEHIVE_HTTP_PORT=9000
CORTEX_HTTP_PORT=9001
SHUFFLE_UI_PORT=3001
SHUFFLE_API_PORT=3002
ELASTICSEARCH_PORT=9200
REDIS_PORT=6379

# Database Configuration
POSTGRES_DB=soar_lab
POSTGRES_USER=soar_user
POSTGRES_PASSWORD=soar_password

# Authentication
WEB_UI_USER=admin
WEB_UI_PASSWORD=admin123

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here

# Paths
RESULTS_DIR=./results
BACKUP_DIR=./backups
LOGS_DIR=./logs
