# SOAR Ransomware Lab - Environment Variables Template
# Copy this file to .env and fill in real values before running `make up`
#
# NEVER commit .env to the repository (it is in .gitignore)
# Generate secure secrets with: soar-lab generate-secrets --env

# === Project ===
COMPOSE_PROJECT_NAME=soar

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=9000
CORTEX_HTTP_PORT=9001
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=15001
ELASTICSEARCH_PORT=9201
REDIS_PORT=6379

# === Ports — SIEM / Observability ===
# NOTE Windows/Hyper-V: ranges 4924-5340 and 55000-55099 may be blocked by Hyper-V
WAZUH_API_PORT=55100
WAZUH_EVENTS_PORT=15141
WAZUH_DASHBOARD_PORT=15601

# === Ports — Management ===
HTTP_PORT=80
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084

# === Elasticsearch ===
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=ElasticLab2024SecurePass
ELASTIC_SECURITY_ENABLED=true
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === TheHive ===
THEHIVE_SECRET=TheHiveSecretLab2024
THEHIVE_API_KEY=rGdCHFJcf3NeTFbu9JhSymBKsTut4NYS

# === Cortex ===
CORTEX_SECRET=CortexSecretLab2024
CORTEX_API_KEY=B9c2xK7mP4nQ3rW6tY1hG5sD2

# === Shuffle ===
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=ShuffleLab2024Secure
SHUFFLE_DEFAULT_APIKEY=f2a8b3c9-d4e1-5f6a-7b8c-9d0e1f2a3b4c
SHUFFLE_ORG_ID=soar-lab-org-default
SHUFFLE_ENV_NAME=Shuffle
DOCKER_API_VERSION=1.45

# === Database (TheHive/Postgres) ===
POSTGRES_USER=thehive
POSTGRES_PASSWORD=PostgresLab2024Secure
POSTGRES_DB=thehive

# === Redis ===
REDIS_PASSWORD=RedisLab2024Secure

# === MISP ===
MISP_HOSTNAME=localhost
MISP_DB_ROOT_PASSWORD=MispRootLab2024Secure
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=MispDBLab2024Secure
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASSWORD=MispAdminLab2024Secure
MISP_ADMIN_ORG=SOAR Lab
MISP_EMAIL=noreply@soar.local
MISP_CONTACT=admin@soar.local
MISP_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
MISP_SALT=f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1
MISP_API_KEY=misp-api-key-soar-lab-default-2024

# === Wazuh ===
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=WazuhApi.Lab2024-Secure
WAZUH_CLUSTER_KEY=wazuh-soar-lab-cluster-key-2024x
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=WazuhApi.Lab2024-Secure

# === Kibana ===
KIBANA_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaLab2024Secure
GRAFANA_DATABASE_HOST=grafana-db
GRAFANA_DATABASE_NAME=grafana
GRAFANA_DATABASE_USER=grafana
GRAFANA_DATABASE_PASSWORD=GrafanaDB2024Secure

# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUILab2024Secure

# === Lab API (FastAPI) ===
API_LOG_LEVEL=INFO
API_AUTH_SECRET=ApiAuthSecretLab2024Secure

# === Security Tokens (SIEM/EDR/Firewall simulation) ===
SIEM_WEBHOOK_TOKEN=SiEMWebhookTokenLab2024Secure
EDR_SIM_TOKEN=EdrSimTokenLab2024Secure
FIREWALL_SIM_TOKEN=FirewallSimTokenLab2024Secure

# === SMTP (optional, for notifications) ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Playbook decision threshold ===
DECISION_SCORE_THRESHOLD=80

# === Webhook rate limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Cortex analyzers ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:8085,http://localhost:8080,http://localhost:9000,http://localhost:9001,http://localhost,http://localhost:8081

# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json (structured, for Promtail→Loki) | text (human-readable)
LOG_FORMAT=json
# LOG_DIR: path for rotating log files; leave empty to log to console only
LOG_DIR=

# === Backups ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Docker resource limits ===
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G
WAZUH_MANAGER_CPU_LIMIT=2.0
WAZUH_MANAGER_CPU_RESERVATION=1.0
WAZUH_MANAGER_MEMORY_LIMIT=2G
WAZUH_MANAGER_MEMORY_RESERVATION=1G
WAZUH_DASHBOARD_CPU_LIMIT=1.0
WAZUH_DASHBOARD_CPU_RESERVATION=0.5
WAZUH_DASHBOARD_MEMORY_LIMIT=1G
WAZUH_DASHBOARD_MEMORY_RESERVATION=512M

# === Docker images ===
SHUFFLE_FRONTEND_IMAGE=shuffler.io/frontend:1.3.0
SHUFFLE_BACKEND_IMAGE=shuffler.io/shuffle:1.3.0
ORBORUS_IMAGE=shuffler.io/orborus:1.3.0

# === External URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Development / Debug ===
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=false
