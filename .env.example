# SOAR Ransomware Lab - Environment Variables Template
# Copia este archivo a `.env.full` y rellena los valores reales antes de ejecutar `make up`.
# `.env.full` es el archivo canónico de entorno; `.env.example` es solo una plantilla.
#
# NUNCA subas `.env.full` al repositorio (está en .gitignore).
# Genera secretos seguros con: soar-lab generate-secrets --env >> .env.full

# === Project ===
COMPOSE_PROJECT_NAME=soar

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=8100
CORTEX_HTTP_PORT=8101
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=8200
OPENSEARCH_PORT=8201
OPENSEARCH_DASHBOARDS_PORT=8202
REDIS_PORT=6379

# === Ports — SIEM / Observability ===
# NOTE Windows/Hyper-V: ranges 4924-5340 and 55000-55099 may be blocked by Hyper-V
WAZUH_API_PORT=8300
WAZUH_EVENTS_PORT=8301
WAZUH_ENROLLMENT_PORT=8302
WAZUH_SYSLOG_PORT=514
WAZUH_INDEXER_PORT=8203
WAZUH_DASHBOARD_PORT=8204

# === Ports — Management ===
HTTP_PORT=80
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084

# === Elasticsearch ===
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=ElasticLab2024SecurePass
ELASTIC_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === OpenSearch (migration target) ===
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=OpenSearchLab2024-Secure
OPENSEARCH_SECURITY_ENABLED=false

# === TheHive ===
THEHIVE_ADMIN_USER=admin
THEHIVE_ADMIN_PASSWORD=TheHiveLab2024-Secure
THEHIVE_SECRET=TheHiveSecretKey2024-LabSecure
THEHIVE_API_KEY=TheHiveApiKey2024-LabSecure

# === Cortex ===
CORTEX_ADMIN_USER=soaradmin
CORTEX_ADMIN_PASSWORD=CortexLab2024-Secure
CORTEX_SECRET=CortexSecretKey2024-LabSecure
CORTEX_API_KEY=CortexApiKey2024-LabSecure

# === Shuffle ===
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=ShuffleLab2024-Secure
SHUFFLE_DEFAULT_APIKEY=ebd6c3db-08a7-4192-81ea-0ad3282bcb09
SHUFFLE_ORG_ID=soar-lab-org-default
SHUFFLE_ENV_NAME=Shuffle
DOCKER_API_VERSION=1.45

# === Database (TheHive/Postgres) ===
POSTGRES_USER=thehive
POSTGRES_PASSWORD=PostgresLab2024-Secure
POSTGRES_DB=thehive

# === Redis ===
REDIS_PASSWORD=RedisLab2024-Secure

# === MISP ===
MISP_HOSTNAME=localhost
MISP_DB_ROOT_PASSWORD=MispRootLab2024-Secure
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=MispDbLab2024-Secure
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASSWORD=MispAdminLab2024-Secure
MISP_ADMIN_ORG=SOAR Lab
MISP_EMAIL=noreply@soar.local
MISP_CONTACT=admin@soar.local
MISP_ENCRYPTION_KEY=MispEncryptKey2024-LabSecure
MISP_SALT=MispSalt2024-LabSecure
MISP_API_KEY=MispApiKey2024LabSecure0123456789ABCDXYZ

# === Wazuh ===
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=WazuhApi.Lab2024-Secure
WAZUH_CLUSTER_KEY=WazuhClusterKey2024-LabSecure
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=WazuhIndexerLab2024-Secure
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=WazuhDashboardLab2024-Secure

# === Kibana (deprecated, replaced by OpenSearch Dashboards) ===
KIBANA_ENCRYPTION_KEY=<KIBANA_ENCRYPTION_KEY>

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaLab2024Secure
GRAFANA_DATABASE_HOST=grafana-db
GRAFANA_DATABASE_NAME=grafana
GRAFANA_DATABASE_USER=grafana
GRAFANA_DATABASE_PASSWORD=GrafanaDbLab2024-Secure

# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUiLab2024-Secure

# === Lab API (FastAPI) ===
API_LOG_LEVEL=INFO
# API_AUTH_SECRET es el secreto legacy; JWT_SECRET_KEY tiene prioridad.
API_AUTH_SECRET=ApiAuthSecret2024-LabSecure
JWT_SECRET_KEY=JwtSecretKey2024-LabSecure
JWT_EXPIRATION_MINUTES=60

# === Security Tokens (SIEM/EDR/Firewall simulation) ===
SIEM_WEBHOOK_TOKEN=SiemWebhookToken2024-LabSecure
EDR_SIM_TOKEN=EdrSimToken2024-LabSecure
FIREWALL_SIM_TOKEN=FirewallSimToken2024-LabSecure

# === SMTP (optional, for notifications) ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Playbook decision threshold ===
DECISION_SCORE_THRESHOLD=80

# === Webhook rate limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Cortex analyzers ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:8085,http://localhost:8086,http://localhost:8081,http://localhost

# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json (structured, for Promtail→Loki) | text (human-readable)
LOG_FORMAT=json
# LOG_DIR: path for rotating log files; leave empty to log to console only
LOG_DIR=

# === Backups ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Docker resource limits ===
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G
WAZUH_MANAGER_CPU_LIMIT=2.0
WAZUH_MANAGER_CPU_RESERVATION=1.0
WAZUH_MANAGER_MEMORY_LIMIT=2G
WAZUH_MANAGER_MEMORY_RESERVATION=1G
WAZUH_DASHBOARD_CPU_LIMIT=1.0
WAZUH_DASHBOARD_CPU_RESERVATION=0.5
WAZUH_DASHBOARD_MEMORY_LIMIT=1G
WAZUH_DASHBOARD_MEMORY_RESERVATION=512M

# === Docker images ===
SHUFFLE_FRONTEND_IMAGE=shuffler.io/frontend:1.3.0
SHUFFLE_BACKEND_IMAGE=shuffler.io/shuffle:1.3.0
ORBORUS_IMAGE=shuffler.io/orborus:1.3.0

# === External URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Development / Debug ===
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=false
