# SOAR Ransomware Lab - Environment Variables Example
# Copia este archivo a .env.full y ajusta los valores antes de ejecutar `make up`
#
# NUNCA subas .env.full al repositorio (está en .gitignore)
# Genera secretos seguros con: python3 scripts/core/generate_secrets.py

# === Proyecto ===
COMPOSE_PROJECT_NAME=soar

# === Puertos — Core SOAR ===
THEHIVE_HTTP_PORT=9000
CORTEX_HTTP_PORT=9001
SHUFFLE_UI_PORT=3001
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=9201
REDIS_PORT=6379

# === Puertos — SIEM / Observabilidad ===
# NOTA Windows/Hyper-V: rangos 55000-55099 y 5600-5699 están bloqueados por reservas de Hyper-V
WAZUH_API_PORT=55100
WAZUH_EVENTS_PORT=15141
WAZUH_DASHBOARD_PORT=15601   # Kibana

# === Puertos — Gestión ===
HTTP_PORT=80
WEB_UI_PORT=8080
API_PORT=8000
DOCS_PORT=3000
MISP_PORT=8082

# === Elasticsearch ===
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME_elastic_password
ELASTIC_SECURITY_ENABLED=true
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === TheHive ===
THEHIVE_SECRET=CHANGE_ME_thehive_secret_min_32_chars
THEHIVE_API_KEY=CHANGE_ME_thehive_api_key

# === Cortex ===
CORTEX_SECRET=CHANGE_ME_cortex_secret_min_32_chars
CORTEX_API_KEY=CHANGE_ME_cortex_api_key

# === Shuffle ===
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=CHANGE_ME_shuffle_password
SHUFFLE_DEFAULT_APIKEY=CHANGE_ME_shuffle_api_key
SHUFFLE_ORG_ID=SOARLab
SHUFFLE_ENV_NAME=Production
DOCKER_API_VERSION=1.44

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_redis_password

# === MISP ===
MISP_HOSTNAME=localhost
MISP_DB_ROOT_PASSWORD=CHANGE_ME_misp_db_root_password
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=CHANGE_ME_misp_db_password
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASSWORD=CHANGE_ME_misp_admin_password
MISP_ADMIN_ORG=SOAR Lab
MISP_EMAIL=noreply@soar.local
MISP_CONTACT=admin@soar.local
MISP_ENCRYPTION_KEY=CHANGE_ME_32_chars_encryption_key_here
MISP_SALT=CHANGE_ME_32_chars_salt_key_here_xx

# === Wazuh ===
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_wazuh_api_password
WAZUH_CLUSTER_KEY=CHANGE_ME_wazuh_cluster_key
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_wazuh_dashboard_password

# === Kibana ===
KIBANA_ENCRYPTION_KEY=CHANGE_ME_kibana_encryption_key_64_hex_chars

# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=CHANGE_ME_web_ui_password

# === Lab API (FastAPI) ===
API_LOG_LEVEL=INFO
API_AUTH_SECRET=CHANGE_ME_api_auth_secret_min_32_chars

# === Tokens de seguridad (simulación SIEM/EDR/Firewall) ===
SIEM_WEBHOOK_TOKEN=CHANGE_ME_siem_webhook_token
EDR_SIM_TOKEN=CHANGE_ME_edr_sim_token
FIREWALL_SIM_TOKEN=CHANGE_ME_firewall_sim_token

# === SMTP (opcional, para notificaciones) ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Umbral de decisión del playbook ===
DECISION_SCORE_THRESHOLD=80

# === Rate limiting webhook Shuffle ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Analyzers Cortex ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (separados por coma) ===
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:9000,http://localhost:9001,http://localhost,http://localhost:8081

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Backups ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Recursos Docker (límites CPU/memoria) ===
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G
WAZUH_MANAGER_CPU_LIMIT=2.0
WAZUH_MANAGER_CPU_RESERVATION=1.0
WAZUH_MANAGER_MEMORY_LIMIT=2G
WAZUH_MANAGER_MEMORY_RESERVATION=1G
WAZUH_DASHBOARD_CPU_LIMIT=1.0
WAZUH_DASHBOARD_CPU_RESERVATION=0.5
WAZUH_DASHBOARD_MEMORY_LIMIT=1G
WAZUH_DASHBOARD_MEMORY_RESERVATION=512M

# === Desarrollo / Debug ===
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=false

# === Hostname externo ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps
