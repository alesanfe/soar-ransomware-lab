# SOAR Ransomware Lab - Environment Variables Template
# Copia este archivo a `.env.full` y rellena los valores reales antes de ejecutar `make up`.
# `.env.full` es el archivo canónico de entorno; `.env.example` es solo una plantilla.
#
# NUNCA subas `.env.full` al repositorio (está en .gitignore).
# Genera secretos seguros con: soar-lab generate-secrets --env >> .env.full

# === Project ===
COMPOSE_PROJECT_NAME=soar
# RUNTIME_DIR is set automatically by `make up` to the runtime/ directory.
# Override only if you want to use a different location for Docker bind mounts.
#ARTIFACTS_DIR=runtime
#RUNTIME_DIR=runtime

# === Internal service URLs (Docker network) ===
# These defaults use Docker service names and internal ports.
# Override only if you rename services or change internal ports.
THEHIVE_URL=http://thehive:9000
CORTEX_URL=http://cortex:9001
ELASTICSEARCH_URL=http://elasticsearch:9200
LOKI_URL=https://loki:3100
TEMPO_URL=https://tempo:3200
PROMETHEUS_URL=https://prometheus:9090
API_URL=http://api:8000

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=8100
CORTEX_HTTP_PORT=8101
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=8200
OPENSEARCH_PORT=8201
OPENSEARCH_DASHBOARDS_PORT=8202

# === Ports — Management ===
HTTP_PORT=80
HTTPS_PORT=443
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084
NETWORK_WATCHER_PORT=15130
# P0.1 watcher Zero-Trust: label|hybrid|name (hybrid = label OR name+image)
WATCHER_TRUST_MODE=hybrid
# Coma-separada: imágenes permitidas para containers managed (vacío = sin allowlist)
# WATCHER_MANAGED_IMAGES=shuffle-orborus,ghcr.io/shuffle
# P0.2: forward del socket del daemon a los workers — OFF por defecto
# (primitiva de escalada; solo para el flujo DinD de analyzers Cortex)
# WATCHER_DOCKER_SOCKET_INJECT=false
# Inyección de /etc/hosts y resolv.conf para DNS de Shuffle (necesaria en lab)
# WATCHER_HOST_INJECT=true
# CFG-031/032: precedencia 12-Factor (env real > .env.full > .env).
# Activar SOLO para el workflow que regenera claves en .env.full
# (init_thehive.py) cuando hay vars obsoletas en el shell.
# SOAR_DOTENV_OVERRIDE=1
TENZIR_API_PORT=15160
TENZIR_LOG_PORT=15140

# === Elasticsearch ===
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=ElasticLab2024SecurePass
ELASTIC_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === OpenSearch (migration target) ===
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=OpenSearchLab2024-Secure
OPENSEARCH_SECURITY_ENABLED=false

# === TheHive ===
THEHIVE_ADMIN_USER=analyst@soar.local
THEHIVE_ADMIN_PASSWORD=TheHiveLab2024-Secure
THEHIVE_SECRET=TheHiveSecretKey2024-LabSecure
THEHIVE_API_KEY=TheHiveApiKey2024-LabSecure

# === Cortex ===
CORTEX_ADMIN_USER=soaradmin
CORTEX_ADMIN_PASSWORD=CortexLab2024-Secure
CORTEX_SECRET=CortexSecretKey2024-LabSecure
CORTEX_API_KEY=CortexApiKey2024-LabSecure

# === Shuffle ===
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=ShuffleLab2024-Secure
SHUFFLE_DEFAULT_APIKEY=replace-with-generated-uuid
SHUFFLE_ORG_ID=soar-lab-org-default
SHUFFLE_ENV_NAME=Shuffle
DOCKER_API_VERSION=1.45
# Internal service URLs (defaults use Docker service names)
SHUFFLE_BACKEND_URL=http://shuffle-backend:5001
SHUFFLE_OPENSEARCH_URL=http://opensearch:9200
TENZIR_URL=http://tenzir-node:5160
# Stale-execution GC (RES-01): periodic abort of zombie EXECUTING docs
SHUFFLE_STALE_GC_ENABLED=true
SHUFFLE_STALE_GC_INTERVAL_S=300
SHUFFLE_STALE_MINUTES=30

# === Database (TheHive/Postgres) ===
POSTGRES_USER=thehive
POSTGRES_PASSWORD=PostgresLab2024-Secure
POSTGRES_DB=thehive

# === Redis ===
REDIS_PASSWORD=RedisLab2024-Secure

# === MISP ===
MISP_HOSTNAME=localhost
MISP_HTTPS_PORT=8083
MISP_DB_ROOT_PASSWORD=MispRootLab2024-Secure
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=MispDbLab2024-Secure
MISP_DB_HOST=misp-db
MISP_DB_PORT=3306
MISP_DB_IMAGE=mariadb:10.11
MISP_REDIS_HOST=redis
MISP_REDIS_PORT=6379
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASSWORD=MispAdminLab2024-Secure
MISP_ADMIN_ORG=SOAR Lab
MISP_EMAIL=noreply@soar.local
MISP_CONTACT=admin@soar.local
MISP_ENCRYPTION_KEY=MispEncryptKey2024-LabSecure
MISP_SALT=MispSalt2024-LabSecure
MISP_API_KEY=MispApiKey2024LabSecure0123456789ABCDXYZ
MISP_URL=https://misp

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaLab2024Secure
GRAFANA_DATABASE_HOST=grafana-db
GRAFANA_DATABASE_NAME=grafana
GRAFANA_DATABASE_USER=grafana
GRAFANA_DATABASE_PASSWORD=GrafanaDbLab2024-Secure

# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUiLab2024-Secure
# AUTH-003: rol RBAC embebido como claim "role" en el JWT de login.
# admin > operator > analyst > viewer (readonly). Desconocido → readonly.
WEB_UI_ROLE=admin

# === Lab API (FastAPI) ===
API_LOG_LEVEL=INFO
# API_AUTH_SECRET es el secreto legacy; JWT_SECRET_KEY tiene prioridad.
API_AUTH_SECRET=ApiAuthSecret2024-LabSecure
JWT_SECRET_KEY=JwtSecretKey2024-LabSecure
JWT_EXPIRATION_MINUTES=60

# === Security Tokens (SIEM/EDR/Firewall simulation) ===
SIEM_WEBHOOK_TOKEN=SiemWebhookToken2024-LabSecure
EDR_SIM_TOKEN=EdrSimToken2024-LabSecure
FIREWALL_SIM_TOKEN=FirewallSimToken2024-LabSecure

# === Playbook decision threshold ===
DECISION_SCORE_THRESHOLD=80

# === Webhook rate limiting ===
WEBHOOK_RATE_LIMIT=60

# === API rate limiting (SOAR-010) ===
# Master switch + per-client sliding-window budgets enforced by middleware.
RATE_LIMIT_ENABLED=true
# Global budget per client (requests per minute)
# Lab profile: generous (E2E load tests must not trip it).
# Hardened profile: 100 / 10 / 30 respectively.
RATE_LIMIT_PER_MINUTE=300
# Stricter budgets for sensitive endpoints
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CONTAIN_PER_MINUTE=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Cortex analyzers ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:8085,http://localhost:8086,http://localhost:8081,http://localhost

# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json (structured, for Promtail→Loki) | text (human-readable)
LOG_FORMAT=json
# LOG_DIR: path for rotating log files; leave empty to log to console only
LOG_DIR=

# === Docker resource limits ===
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G

# === Docker images ===
SHUFFLE_FRONTEND_IMAGE=ghcr.io/shuffle/shuffle-frontend:2.2.1
SHUFFLE_BACKEND_IMAGE=ghcr.io/shuffle/shuffle-backend:2.2.1
ORBORUS_IMAGE=ghcr.io/shuffle/shuffle-orborus:2.2.1-patched
REDIS_IMAGE=redis:7-alpine
THEHIVE_IMAGE=strangebee/thehive:5.7.8-1
TENZIR_IMAGE=tenzir/tenzir:v6.8.1
NGINX_IMAGE=nginx:1.25-alpine
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:7.10.2
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.10.0
OPENSEARCH_DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.10.0
# Docker API proxy for the hardened profile (make up HARDENED=1)
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.1
MISP_CORE_IMAGE=ghcr.io/misp/misp-docker/misp-core:v2.5.44
MISP_MODULES_IMAGE=ghcr.io/misp/misp-docker/misp-modules:v3.0.9
POSTGRES_IMAGE=postgres:14-alpine
GRAFANA_IMAGE=grafana/grafana:10.3.4
GRAFANA_RENDERER_IMAGE=grafana/grafana-image-renderer:3.10.4
LOKI_IMAGE=grafana/loki:2.9.10
PROMTAIL_IMAGE=grafana/promtail:2.9.9
# GRAF-D5: S3-compatible object storage for Loki chunks + Tempo blocks.
# SeaweedFS (docker.io/minio/minio is pull-restricted in this environment).
S3_IMAGE=chrislusf/seaweedfs:4.53
# Must match infra/docker/config/seaweedfs/iam.config.json credentials.
S3_ACCESS_KEY=soar-s3
S3_SECRET_KEY=soar-s3-secret-change-me
# GRAF-D10: Grafana HTTPS endpoint via nginx (cert: infra/docker/config/certs).
GRAFANA_TLS_PORT=8444

# === External URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Service-to-service auth (SOAR-011) ===
# When true, mutating endpoints (/backup/*, /tests/run, /api/v1/contain,
# /api/v1/cache/ioc) require Bearer JWT or X-Service-Token.
# Enabled by default (secure-by-default); set false only for throwaway lab runs.
API_REQUIRE_AUTH=true
# Shared token accepted in X-Service-Token for internal callers.
INTERNAL_SERVICE_TOKEN=replace-with-generated-token
# Rotation grace slots (S2): keep the previous secret here while callers
# migrate, then clear. Authentications via *_PREV are audited as
# "rotation-grace" and logged as warnings.
#INTERNAL_SERVICE_TOKEN_PREV=
#SHUFFLE_WEBHOOK_TOKEN_PREV=
# Analyst-in-the-loop (F4): 1 parks POST /api/v1/contain behind
# POST /api/v1/contain/{approval_id}/approve (measures human MTTR).
SOAR_CONTAIN_REQUIRE_APPROVAL=0
# Real containment: 1 enables POST /api/v1/contain mode=enforce, which
# disconnects/pauses an allowlisted victim container (docker.sock).
# Off by default — the lab workflow uses mode=simulation.
SOAR_CONTAIN_ENFORCE=0
SOAR_CONTAIN_ALLOW_PREFIX=victim_

# === Async alert admission (PERF-001) ===
# POST /api/v1/alerts returns 202 immediately; a worker forwards each
# admission to the Shuffle webhook with retry + DLQ (Redis Streams).
# Requires REDIS_URL; when disabled or Redis is down the endpoint returns 503.
ALERT_INGEST_ENABLED=true
# Override the forward target (default: webhook_info.json -> SHUFFLE_WEBHOOK_URL)
#ALERT_INGEST_TARGET_URL=http://shuffle-backend:5001/api/v1/hooks/<hook>
ALERT_INGEST_MAX_ATTEMPTS=5
ALERT_INGEST_CONCURRENCY=4
# PERF-003: nominal queue capacity — when the admission stream holds
# more entries, POST /api/v1/alerts returns 503 + Retry-After: 5
# instead of silently trimming unprocessed work (stream hard cap ~100k)
ALERT_INGEST_MAX_DEPTH=50000

# --- Fase-0 hardening (9.5 backlog) ---
# TLS verification — defaults ON for every HTTP integration. Set to 0/false
# only for local development with self-signed certificates.
AIOHTTP_VERIFY_TLS=true
THEHIVE_VERIFY_TLS=true
CORTEX_VERIFY_TLS=true
SHUFFLE_VERIFY_TLS=true
# Webhook alert sender (send_alert script path).
ALERT_SENDER_VERIFY_TLS=true
# Comma-separated CIDRs of proxies allowed to supply X-Forwarded-For.
# Empty (default) = XFF ignored → rate-limit buckets keyed on the TCP peer.
# Example for the docker bridge: RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
RATE_LIMIT_TRUSTED_PROXIES=
MISP_VERIFY_TLS=true
GRAFANA_VERIFY_TLS=true
ELASTICSEARCH_VERIFY_TLS=true
# Shuffle's internal OpenSearch datastore ships a self-signed cert → default
# off. Set true once a proper CA cert is deployed (BUG-138 hardening hook).
SHUFFLE_OPENSEARCH_VERIFY_TLS=false
# Rate-limit store: "memory" (default, per-instance) or "redis" (shared
# sliding window across API instances, requires REDIS_URL).
RATE_LIMIT_BACKEND=memory
# WS-ticket store: "memory" (default, per-instance) or "redis" (shared
# single-use tickets across uvicorn workers, requires REDIS_URL). Must be
# "redis" when UVICORN_WORKERS>1 or tickets issued on one worker will be
# rejected by the others.
WS_TICKET_BACKEND=memory
# Uvicorn worker processes (default 1). >1 requires
# RATE_LIMIT_BACKEND=redis + WS_TICKET_BACKEND=redis. WebSocket broadcast
# fanout stays per-worker (live-log clients see events from their own
# worker) — accepted limitation, see docs/adr.
UVICORN_WORKERS=1
# Directory of mounted Docker/Compose secrets (default /run/secrets).
# resolve_secret checks env var → this dir → .env.full, in that order.
DOCKER_SECRETS_DIR=

# === Artifact retention ===
# Days to keep backups/results/logs before CleanupService removes them.
# Resolution chain: API param > config > this var > 30-day fallback.
RETENTION_DAYS=30

# === Service container names & health URLs (Settings discovery) ===
# Used by Settings.get_service_urls() for health monitoring and
# `make doctor` diagnostics. Defaults match docker-compose service names.
API_CONTAINER=soar_api
API_HEALTH_URL=http://api:8000/health
API_HOST=127.0.0.1
THEHIVE_CONTAINER=thehive
THEHIVE_HEALTH_URL=http://thehive:9000/api/status
CORTEX_CONTAINER=cortex
CORTEX_HEALTH_URL=http://cortex:9001/api/status
SHUFFLE_CONTAINER=shuffle-backend
SHUFFLE_HEALTH_URL=http://shuffle-backend:5001/api/v1/health
SHUFFLE_FRONTEND_CONTAINER=shuffle-frontend
SHUFFLE_UI_HEALTH_URL=http://shuffle-frontend:80
SHUFFLE_URL=http://shuffle-backend:5001
SHUFFLE_WEBHOOK_URL=http://localhost:5001/api/v1/hooks
ELASTICSEARCH_CONTAINER=elasticsearch
ELASTICSEARCH_HEALTH_URL=http://elasticsearch:9200/_cluster/health
ES_URL=http://elasticsearch:9200
MISP_CONTAINER=misp
MISP_HEALTH_URL=https://misp:443/users/login
REDIS_CONTAINER=redis
REDIS_HEALTH_URL=redis://redis:6379
REDIS_URL=
NGINX_CONTAINER=nginx
NGINX_HEALTH_URL=http://nginx:80/health
GRAFANA_CONTAINER=grafana
GRAFANA_HEALTH_URL=http://grafana:3000/api/health
LOKI_CONTAINER=loki
LOKI_HEALTH_URL=http://loki:3100/ready
PROMTAIL_CONTAINER=promtail
PROMTAIL_HEALTH_URL=http://promtail:9080/ready
DOCS_CONTAINER=docs-site
DOCS_HEALTH_URL=http://docs-site:3000

# === Deployment profile & storage ===
# "production" enables fail-fast config validation at boot (CFG-BOOT-001).
SOAR_ENV=development
BACKUP_DIR=
BASE_DIR=
COMPRESS=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
JWT_ALGORITHM=HS256

# === OpenTelemetry (O1) ===
# 1 enables OTLP/HTTP span export — FastAPI + outbound requests are
# auto-instrumented so ingest → Shuffle/TheHive/Cortex/ES calls appear
# as one distributed trace. Point the endpoint at any OTLP receiver.
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=soar-api
# KPI alert routing (O3): POST threshold violations to this webhook.
#KPI_ALERT_WEBHOOK_URL=
KPI_ALERT_INTERVAL_S=300

# === SSO / OIDC (AUTH-*: optional docker-compose.sso.yml overlay) ===
# Keycloak bootstrap admin + realm OIDC client. Lab-only defaults —
# replace in any deployment exposed beyond localhost.
KEYCLOAK_PORT=8087
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=soar-keycloak-admin
OIDC_CLIENT_SECRET=soar-lab-oidc-secret
# oauth2-proxy cookie secret: base64/hex, >=32 bytes. Generate a real one
# with: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH2_PROXY_COOKIE_SECRET=soarlab-cookie-secret-32bytes-XX
# Grafana native OIDC — set true only when the sso overlay is deployed.
GF_OAUTH_ENABLED=false

# Shuffle app scaling (warm apps / worker pool)
SHUFFLE_SWARM_CONFIG=docker
SHUFFLE_SWARM_NETWORK_NAME=soar_swarm
SHUFFLE_APP_REPLICAS=4
SHUFFLE_SCALE_REPLICAS=1
SHUFFLE_WORKER_SERVER_URL=http://shuffle-workers:33333

# Runtime/report bind-mount roots (absolute paths, no trailing slash)
ARTIFACTS_DIR=
RUNTIME_DIR=
REPORTS_DIR=
