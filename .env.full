# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaLab2024Secure
GRAFANA_DATABASE_HOST=grafana-db
GRAFANA_DATABASE_NAME=grafana
GRAFANA_DATABASE_USER=grafana
GRAFANA_DATABASE_PASSWORD=GrafanaDB2024Secure

# === Web Management UI ===
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUILab2024Secure

# === Lab API (FastAPI) ===
API_LOG_LEVEL=INFO
API_AUTH_SECRET=ApiAuthSecretLab2024Secure

# === Security Tokens (SIEM/EDR/Firewall simulation) ===
SIEM_WEBHOOK_TOKEN=SiEMWebhookTokenLab2024Secure
EDR_SIM_TOKEN=EdrSimTokenLab2024Secure
FIREWALL_SIM_TOKEN=FirewallSimTokenLab2024Secure

# === SMTP (optional, for notifications) ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Playbook decision threshold ===
DECISION_SCORE_THRESHOLD=80

# === Webhook rate limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Cortex analyzers ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:8085,http://localhost:8080,http://localhost:9000,http://localhost:9001,http://localhost,http://localhost:8081

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=

# === Backups ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Docker resource limits ===
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G
WAZUH_MANAGER_CPU_LIMIT=2.0
WAZUH_MANAGER_CPU_RESERVATION=1.0
WAZUH_MANAGER_MEMORY_LIMIT=2G
WAZUH_MANAGER_MEMORY_RESERVATION=1G
WAZUH_DASHBOARD_CPU_LIMIT=1.0
WAZUH_DASHBOARD_CPU_RESERVATION=0.5
WAZUH_DASHBOARD_MEMORY_LIMIT=1G
WAZUH_DASHBOARD_MEMORY_RESERVATION=512M

# === Docker images ===
SHUFFLE_FRONTEND_IMAGE=ghcr.io/shuffle/shuffle-frontend:2.2.1
SHUFFLE_BACKEND_IMAGE=ghcr.io/shuffle/shuffle-backend:2.2.1
ORBORUS_IMAGE=ghcr.io/shuffle/shuffle-orborus:latest

# === External URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Service URLs for E2E tests (Docker-internal URLs for container execution) ===
SHUFFLE_URL=http://soar_shuffle_backend:5001
ES_URL=http://elasticsearch:9200
THEHIVE_URL=http://thehive:9000
CORTEX_URL=http://cortex:9001
MISP_URL=http://misp:80
WAZUH_URL=https://wazuh-manager:55000
GRAFANA_URL=http://grafana:3000

# === Development / Debug ===
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=false
ARTIFACTS_DIR=/var/lib/soar/artifacts
