# SOAR Ransomware Lab - Environment Variables
# Windows-safe: no $ ! @ in passwords to avoid Make/Docker variable expansion.

# === Project ===
COMPOSE_PROJECT_NAME=soar

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=19000
CORTEX_HTTP_PORT=19001
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=15001
ELASTICSEARCH_PORT=19200
REDIS_PORT=6379

# === Ports — SIEM / Observability ===
WAZUH_API_PORT=55100
WAZUH_EVENTS_PORT=15141
WAZUH_DASHBOARD_PORT=15601

# === Ports — Management ===
HTTP_PORT=80
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084

# === Elasticsearch ===
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=ElasticLab2024SecurePass
ES_JAVA_OPTS=-Xms2g -Xmx2g

# === TheHive ===
THEHIVE_SECRET=TheHiveSecretLab2024
THEHIVE_API_KEY=yd5jDcIf8lh1/49ViU5adgdkfMC/wAA5

# === Cortex ===
CORTEX_SECRET=CortexSecretLab2024
CORTEX_API_KEY=7dHlmCT31sXQT1fErOaTOg6VOariknST

