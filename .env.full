# SOAR Ransomware Lab - Environment Variables Template
# Copia este archivo a `.env.full` y rellena los valores reales antes de ejecutar `make up`.
# `.env.full` es el archivo canónico de entorno; `.env.example` es solo una plantilla.
#
# NUNCA subas `.env.full` al repositorio (está en .gitignore).
# Genera secretos seguros con: soar-lab generate-secrets --env >> .env.full

# === Project ===
COMPOSE_PROJECT_NAME=soar

# === Ports — Core SOAR ===
THEHIVE_HTTP_PORT=8100
CORTEX_HTTP_PORT=8101
SHUFFLE_UI_PORT=8081
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=8200
OPENSEARCH_PORT=8201
OPENSEARCH_DASHBOARDS_PORT=8202
REDIS_PORT=6379

# === Ports — SIEM / Observability ===
# NOTE Windows/Hyper-V: ranges 4924-5340 and 55000-55099 may be blocked by Hyper-V
WAZUH_API_PORT=8300
WAZUH_EVENTS_PORT=8301
WAZUH_ENROLLMENT_PORT=8302
WAZUH_SYSLOG_PORT=514
WAZUH_INDEXER_PORT=8203
WAZUH_DASHBOARD_PORT=8204

# === Ports — Management ===
HTTP_PORT=80
WEB_UI_PORT=8085
API_PORT=8000
DOCS_PORT=8086
MISP_PORT=8083
GRAFANA_PORT=8084

# === Elasticsearch ===
