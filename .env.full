# SOAR Ransomware Lab - Complete Environment Configuration
# This file contains all environment variables for the full SOAR/TI stack

# === Project Configuration ===
COMPOSE_PROJECT_NAME=soar

# === Network Ports Configuration ===
# Core SOAR Services
THEHIVE_HTTP_PORT=9000
CORTEX_HTTP_PORT=9001
SHUFFLE_UI_PORT=3001
SHUFFLE_API_PORT=5001
ELASTICSEARCH_PORT=9201
REDIS_PORT=6379

# Wazuh SIEM Services
WAZUH_API_PORT=55100
WAZUH_EVENTS_PORT=15141
WAZUH_DASHBOARD_PORT=15601

# Management and Documentation
WEB_UI_PORT=8080
API_PORT=8000
DOCS_PORT=3000

# Web Server
HTTP_PORT=80

# === Security Configuration ===
ELASTIC_PASSWORD=ElasticSecurePassword123!@#
ELASTIC_USERNAME=elastic

# Shuffle Configuration
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=ShuffleSecurePassword456!@#
SHUFFLE_DEFAULT_APIKEY=e18f1fe3-1591-44ec-aff4-c6e759b3a8bf
SHUFFLE_ORG_ID=b4fa04e8-6de3-45f1-920e-721b522a0eba
SHUFFLE_ENV_NAME=Shuffle
DOCKER_API_VERSION=1.44

# TheHive Configuration
THEHIVE_SECRET=thehive-secret-key-123-secure
THEHIVE_API_KEY=thehive-api-key-456-secure

# Cortex Configuration
CORTEX_SECRET=cortex-secret-key-789-secure
CORTEX_API_KEY=cortex-api-key-012-secure

# Database Passwords
POSTGRES_USER=thehive
POSTGRES_PASSWORD=PostgresSecurePassword345!@#
POSTGRES_DB=thehive

# Redis Configuration
REDIS_PASSWORD=RedisSecurePassword678!@#

# MISP Configuration
MISP_PORT=8082
MISP_HOSTNAME=localhost
MISP_DB_ROOT_PASSWORD=MispDbRootPassword123!@#
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=MispDbPassword456!@#
MISP_ADMIN_EMAIL=admin@soar.local
MISP_ADMIN_PASSWORD=MispAdminPassword789!@#
MISP_ADMIN_ORG=SOAR Lab
MISP_EMAIL=noreply@soar.local
MISP_CONTACT=admin@soar.local
MISP_ENCRYPTION_KEY=random_encryption_key_32_chars_long_secure
MISP_SALT=random_salt_32_chars_long_secure_key
MISP_API_KEY=misp-api-key-345-secure-token

# Wazuh Configuration
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=WazuhApiPassword123!@#
WAZUH_CLUSTER_KEY=wazuh-cluster-key
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=WazuhDashboardPassword456!@#

# Kibana Configuration (reemplaza Wazuh Dashboard)
KIBANA_ENCRYPTION_KEY=a7a6311933d3503b89bc2dbc36572c33a6c10925682e591bffcab6911c06786d

# Web Management UI Configuration
WEB_UI_USER=admin
WEB_UI_PASSWORD=WebUIPassword123!@#

# Documentation Site Configuration
DOCS_PORT=3000

# API Configuration
API_LOG_LEVEL=INFO
API_AUTH_SECRET=ApiAuthSecretKey456!@#7890123456

# === Docker Images Configuration ===
SHUFFLE_FRONTEND_IMAGE=shuffler.io/frontend:1.3.0
SHUFFLE_BACKEND_IMAGE=shuffler.io/shuffle:1.3.0
ORBORUS_IMAGE=shuffler.io/orborus:1.3.0

# === Elasticsearch Configuration ===
ES_JAVA_OPTS=-Xms2g -Xmx2g
ELASTIC_SECURITY_ENABLED=true


# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Performance Configuration ===
MAX_CONCURRENT_ANALYZERS=3
ANALYZER_TIMEOUT=30
ANALYZER_RETRIES=1

# === Rate Limiting ===
WEBHOOK_RATE_LIMIT=60
WEBHOOK_PAYLOAD_MAX_SIZE=65536

# === Health Check Configuration ===
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# === Decision Thresholds ===
DECISION_SCORE_THRESHOLD=80

# === Security Tokens ===
SIEM_WEBHOOK_TOKEN=SiemToken123!@#
EDR_SIM_TOKEN=EdrToken456!@#
FIREWALL_SIM_TOKEN=FirewallToken789!@#

# === SMTP Configuration ===
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# === Documentation Configuration ===
DOCS_BASE_URL=/
DOCS_SITE_TITLE=SOAR Ransomware Lab
DOCS_SITE_DESCRIPTION=Security Orchestration, Automation and Response Laboratory

# === CORS Configuration ===
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:9000,http://localhost:9001,http://localhost,http://localhost:8081,https://localhost,https://localhost:443

# === Backup Configuration ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=true

# === Monitoring Configuration ===
METRICS_ENABLED=true
METRICS_INTERVAL=15s
ALERTS_ENABLED=true
ALERT_SMTP_ENABLED=false

# === Development/Debug Configuration ===
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=false

# === External Service URLs ===
OUTER_HOSTNAME=localhost
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps

# === Resource Limits Configuration ===
# CPU limits (in cores)
ELASTICSEARCH_CPU_LIMIT=2.0
ELASTICSEARCH_CPU_RESERVATION=1.0
THEHIVE_CPU_LIMIT=2.0
THEHIVE_CPU_RESERVATION=1.0
CORTEX_CPU_LIMIT=2.0
CORTEX_CPU_RESERVATION=1.0
SHUFFLE_CPU_LIMIT=2.0
SHUFFLE_CPU_RESERVATION=1.0
WAZUH_MANAGER_CPU_LIMIT=2.0
WAZUH_MANAGER_CPU_RESERVATION=1.0
WAZUH_DASHBOARD_CPU_LIMIT=1.0
WAZUH_DASHBOARD_CPU_RESERVATION=0.5

# Memory limits (in bytes)
ELASTICSEARCH_MEMORY_LIMIT=4G
ELASTICSEARCH_MEMORY_RESERVATION=2G
THEHIVE_MEMORY_LIMIT=4G
THEHIVE_MEMORY_RESERVATION=2G
CORTEX_MEMORY_LIMIT=4G
CORTEX_MEMORY_RESERVATION=2G
SHUFFLE_MEMORY_LIMIT=4G
SHUFFLE_MEMORY_RESERVATION=2G
WAZUH_MANAGER_MEMORY_LIMIT=2G
WAZUH_MANAGER_MEMORY_RESERVATION=1G
WAZUH_DASHBOARD_MEMORY_LIMIT=1G
WAZUH_DASHBOARD_MEMORY_RESERVATION=512M


# === Feature Flags ===


# === Custom Configuration ===
CUSTOM_CONFIG_DIR=./config/custom
CUSTOM_SCRIPTS_DIR=./scripts/custom
CUSTOM_PLUGINS_DIR=./plugins/custom
