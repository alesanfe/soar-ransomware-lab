# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json (structured, for Promtail→Loki) | text (human-readable)
LOG_FORMAT=json
# LOG_DIR: path for rotating log files; leave empty to log to console only
LOG_DIR=

