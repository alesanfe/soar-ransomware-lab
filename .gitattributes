# Force LF line endings for shell scripts (prevents Windows CRLF breaking bash)
*.sh        text eol=lf
Vagrantfile text eol=lf
Makefile    text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
*.md        text eol=lf

# Windows-native files keep CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
