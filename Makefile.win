.PHONY: init-webhook clean-shuffle clean-thehive

help:
	@echo "=========================================="
	@echo "  SOAR Ransomware Lab - Windows Makefile"
	@echo "=========================================="
	@echo ""
	@echo "[Service Management]"
	@echo "  make up            - Start all SOAR services (Docker stack)"
	@echo "  make down          - Stop services and remove volumes"
	@echo "  make restart       - Restart all services"
	@echo "  make logs          - View service logs (follow mode)"
	@echo "  make ps            - Show running containers status"
	@echo "  make health        - Check health of core services"
	@echo "  make init-webhook  - Initialize Shuffle webhook for alerts"
	@echo "  make clean-shuffle - Clean stale Shuffle executions (OpenSearch + workers)"
	@echo "  make clean-thehive - Delete old TheHive cases (prevents ES timeout)"
	@echo ""
	@echo "[Testing]"
	@echo "  make test-unit        - Run unit tests only (in Docker)"
	@echo "  make test-integration - Run integration tests (in Docker)"
	@echo "  make test-e2e         - Run all E2E tests (in Docker)"
	@echo "  make test-e2e-report  - Generate E2E report (MD+JSON+charts) from lab data"
	@echo "  make test-e2e-tcXX    - Run individual TC-XX (00-34, KPI)"
	@echo "  make test-atomic     - Run atomic operation tests (in Docker)"
	@echo "  make test-smoke      - Run smoke tests (in Docker)"
	@echo "  make test-security   - Run security tests (in Docker)"
	@echo "  make test-performance- Run performance tests (in Docker)"
	@echo "  make test-all        - Run ALL tests (unit + integration + e2e) (in Docker)"
	@echo "  make test-coverage   - Run tests with coverage report (in Docker)"
	@echo "  make test-docker-runtime - Run Docker runtime status tests"
	@echo ""
	@echo "[SIEM Simulation]"
	@echo "  make simulate            - Simulate ransomware attack (5 alerts)"
	@echo "  make simulate-malicious  - Send 1 malicious alert"
	@echo "  make simulate-benign     - Send 1 benign alert"
	@echo "  make simulate-batch N=10 - Send N alerts (default: 10)"
	@echo ""
	@echo "[Maintenance]"
	@echo "  make deps               - Install Python dependencies"
	@echo "  make deps-test          - Install test dependencies"
	@echo "  make deps-lint          - Install linter dependencies (ruff, black, isort, flake8, mypy)"
	@echo "  make generate-secrets   - Generate secure passwords/tokens"
	@echo "  make generate-iocs      - Generate simulated IOCs"
	@echo "  make certs              - Generate TLS certificates for Nginx"
	@echo "  make metrics            - Calculate KPIs from logs"
	@echo "  make backup             - Create backup of runtime data"
	@echo "  make restore            - Restore from backup (BACKUP=<name>)"
	@echo "  make validate-credentials - Validate credential synchronization"
	@echo "  make clean              - Clean temporary files (reports, runtime logs)"
	@echo "  make reset              - Full reset: destroy containers, volumes, networks + clean"
	@echo ""
	@echo "[Code Quality]"
	@echo "  make lint               - Run ALL linters: ruff + black + isort + flake8 + mypy + docs-lint"
	@echo "  make docs-lint          - Run doc linters (markdownlint, lychee, docs_quality) + generate docs"
	@echo "  make lint-fix           - Auto-fix code with ruff, black and isort"
	@echo "  make quality            - Run quality checks -> reports/quality/quality-summary.md"
	@echo "  make mutation           - Run mutation testing (mutmut) in Docker -> reports/mutmut/"
	@echo "  make test-review        - Test review report (7-dimension methodology) -> reports/test-review/"
	@echo "  make holistic-review    - Holistic Project Radar (5 layers, 15 dims) -> reports/holistic/"
	@echo ""
	@echo "[Development]"
	@echo "  make sync-src           - Sync src/ and pytest.ini into soar_api container"
	@echo "  make sync-tests         - Sync tests/ into soar_api container"
	@echo "  make dev-reload         - Reload code in API container without rebuild"
	@echo "  make dev-shell          - Open shell in API container"
	@echo "  make dev-debug          - Start API in debug mode"
	@echo "  make logs-service       - View logs for a specific service (SERVICE=<name>)"
	@echo ""
	@echo "[Documentation]"
	@echo "  make docs-build         - Build documentation"
	@echo "  make docs-serve         - Serve documentation at http://localhost:8001"
	@echo "  make docs-lint          - Run documentation linters (markdownlint, lychee, docs_quality)"
	@echo ""
	@echo "[Quick Start]"
	@echo "  1. make up                    # Start SOAR stack"
	@echo "  2. make init-webhook          # Initialize webhook"
	@echo "  3. make simulate              # Test with sample alert"
	@echo "  4. make test-e2e-tc01         # Run malicious IOC tests"
	@echo ""

install:
	pip install -e .

install-dev:
	pip install -e ".[dev]"

# Service Management
validate-credentials:
	@echo "Validating credential synchronization..."
	@if not exist .env.full (echo ERROR: .env.full not found. Please create it from .env.example && exit 1)
	@python src/soar_lab/infrastructure/validate_credentials.py

verify-digests:
	@echo "Verifying Docker image digests..."
	@python scripts/maintenance/verify_image_digests.py

verify-digests-write:
	@echo "Generating requirements-docker.lock with image digests..."
	@python scripts/maintenance/verify_image_digests.py --write

up:
	@echo "==> [1/19] Checking .env.full exists..."
	@powershell -NoProfile -Command "if (!(Test-Path .env.full)) { if (Test-Path .env.full.reset.bak) { Move-Item -Force .env.full.reset.bak .env.full } elseif (Test-Path .env.example) { Copy-Item -Force .env.example .env.full } else { Write-Host 'ERROR: .env.full and .env.example are missing'; exit 1 } }"
	@echo "==> [2/19] Generating .env.full and Grafana datasources from templates..."
	@python scripts/setup/generate_secrets.py
	@echo "==> [3/19] Generating local .env for Docker Desktop with project-local runtime and reports dirs..."
	@python -c "import pathlib; s=pathlib.Path('.env.full').read_text(encoding='utf-8'); r=str(pathlib.Path('runtime').resolve()).replace('\\','/'); p=str(pathlib.Path('reports').resolve()).replace('\\','/'); lines=[l for l in s.splitlines() if not l.startswith('RUNTIME_DIR=') and not l.startswith('REPORTS_DIR=') and not l.startswith('ARTIFACTS_DIR=')]; lines.append(f'ARTIFACTS_DIR={r}'); lines.append(f'RUNTIME_DIR={r}'); lines.append(f'REPORTS_DIR={p}'); pathlib.Path('.env').write_text('\n'.join(lines), encoding='utf-8')"
	@echo "==> [4/19] Verifying Docker image digests (non-blocking)..."
	-@python scripts/maintenance/verify_image_digests.py --env-file .env 2>nul || echo [INFO] Digest verification skipped (Docker not running or registry unreachable)
	@echo "==> [5/19] Creating Docker networks with compose labels (if not exist)..."
	@docker network inspect soar_net >nul 2>&1 || docker network create --label "com.docker.compose.network=soar_net" --label "com.docker.compose.project=soar" soar_net
	@docker network inspect logging_net >nul 2>&1 || docker network create --label "com.docker.compose.network=logging_net" --label "com.docker.compose.project=soar" logging_net
	@docker network inspect ti_net >nul 2>&1 || docker network create --label "com.docker.compose.network=ti_net" --label "com.docker.compose.project=soar" ti_net
	@echo "==> [6/19] Creating required directories..."
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\elasticsearch')) { New-Item -ItemType Directory -Force -Path 'runtime\data\elasticsearch' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\thehive\files')) { New-Item -ItemType Directory -Force -Path 'runtime\data\thehive\files' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\cortex')) { New-Item -ItemType Directory -Force -Path 'runtime\data\cortex' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\shuffle\apps')) { New-Item -ItemType Directory -Force -Path 'runtime\data\shuffle\apps' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\shuffle\files')) { New-Item -ItemType Directory -Force -Path 'runtime\data\shuffle\files' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\redis')) { New-Item -ItemType Directory -Force -Path 'runtime\data\redis' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\misp\db')) { New-Item -ItemType Directory -Force -Path 'runtime\data\misp\db' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\misp\files')) { New-Item -ItemType Directory -Force -Path 'runtime\data\misp\files' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\misp\configs')) { New-Item -ItemType Directory -Force -Path 'runtime\data\misp\configs' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\misp\logs')) { New-Item -ItemType Directory -Force -Path 'runtime\data\misp\logs' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\loki')) { New-Item -ItemType Directory -Force -Path 'runtime\data\loki' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\grafana')) { New-Item -ItemType Directory -Force -Path 'runtime\data\grafana' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\backups')) { New-Item -ItemType Directory -Force -Path 'runtime\backups' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\logs')) { New-Item -ItemType Directory -Force -Path 'runtime\logs' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\results')) { New-Item -ItemType Directory -Force -Path 'runtime\results' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\logs\nginx')) { New-Item -ItemType Directory -Force -Path 'runtime\logs\nginx' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\logs\misp')) { New-Item -ItemType Directory -Force -Path 'runtime\logs\misp' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\grafana_db')) { New-Item -ItemType Directory -Force -Path 'runtime\data\grafana_db' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\data\opensearch')) { New-Item -ItemType Directory -Force -Path 'runtime\data\opensearch' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'reports\validation\results')) { New-Item -ItemType Directory -Force -Path 'reports\validation\results' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'reports\coverage')) { New-Item -ItemType Directory -Force -Path 'reports\coverage' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\config')) { New-Item -ItemType Directory -Force -Path 'runtime\config' }"
	@powershell -NoProfile -Command "if (!(Test-Path 'runtime\logs\notify.log')) { Set-Content -Path 'runtime\logs\notify.log' -Value \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] STEP: SOAR Lab initialized and ready`n\" -Encoding UTF8 }"
	@echo "==> [7/19] Rendering Docker config files from templates..."
	@python scripts/setup/render_configs.py --env-file .env
	@echo "==> [8/19] Building and starting Docker containers..."
	@echo "  [8a] Starting OpenSearch first (for index template setup)..."
	-@$(DC) up -d --build opensearch 2>nul || true
	@powershell -NoProfile -Command "for ($$i=0; $$i -lt 30; $$i++) { $$r=docker exec soar_opensearch curl -sf http://localhost:9200/_cluster/health 2>&1; if ($$LASTEXITCODE -eq 0) { break } Start-Sleep -Seconds 5 }"
	@echo "  [8b] Pre-creating OpenSearch index templates (before backend starts)..."
	-@docker exec soar_opensearch python3 -c "import urllib.request,json; tpl={'index_patterns':['environments*'],'settings':{'number_of_replicas':0,'refresh_interval':'1s'},'mappings':{'dynamic_templates':[{'strings_as_keywords':{'match_mapping_type':'string','mapping':{'type':'keyword'}}}],'properties':{'Name':{'type':'keyword'},'Registered':{'type':'boolean'},'Type':{'type':'keyword'},'archived':{'type':'boolean'},'created':{'type':'long'},'edited':{'type':'long'},'default':{'type':'boolean'},'id':{'type':'keyword'},'org_id':{'type':'keyword'},'orborus_uuid':{'type':'keyword'},'running_ip':{'type':'keyword'},'run_type':{'type':'keyword'},'sensor_group':{'type':'keyword'}}}}; data=json.dumps(tpl).encode(); req=urllib.request.Request('http://localhost:9200/_template/soar_environments',data=data,method='PUT',headers={'Content-Type':'application/json'}); urllib.request.urlopen(req,timeout=15); print('environments template created')" 2>nul || echo [INFO] environments template skipped
	-@docker exec soar_opensearch python3 -c "import urllib.request,json; tpl={'index_patterns':['workflowqueue*'],'settings':{'number_of_replicas':0,'refresh_interval':'1s'},'mappings':{'dynamic_templates':[{'strings_as_keywords':{'match_mapping_type':'string','mapping':{'type':'keyword'}}}],'properties':{'authgroup':{'type':'keyword'},'authorization':{'type':'keyword'},'created_at':{'type':'long'},'environments':{'type':'keyword'},'execution_argument':{'type':'text'},'execution_id':{'type':'keyword'},'execution_source':{'type':'keyword'},'priority':{'type':'long'},'start':{'type':'long'},'status':{'type':'keyword'},'type':{'type':'keyword'},'workflow_id':{'type':'keyword'}}}}; data=json.dumps(tpl).encode(); req=urllib.request.Request('http://localhost:9200/_template/soar_workflowqueue',data=data,method='PUT',headers={'Content-Type':'application/json'}); urllib.request.urlopen(req,timeout=15); print('workflowqueue template created')" 2>nul || echo [INFO] workflowqueue template skipped
	-@docker exec soar_opensearch python3 -c "import urllib.request,json; tpl={'index_patterns':['notifications*'],'settings':{'number_of_replicas':0,'refresh_interval':'1s'},'mappings':{'dynamic_templates':[{'strings_as_keywords':{'match_mapping_type':'string','mapping':{'type':'keyword'}}}],'properties':{'action_name':{'type':'keyword'},'created_at':{'type':'long'},'updated_at':{'type':'long'},'execution_id':{'type':'keyword'},'node_id':{'type':'keyword'},'node_status':{'type':'keyword'},'org_id':{'type':'keyword'},'severity':{'type':'keyword'},'title':{'type':'text'},'workflow_id':{'type':'keyword'},'read':{'type':'boolean'},'ignored':{'type':'boolean'},'dismissable':{'type':'boolean'},'personal':{'type':'boolean'}}}}; data=json.dumps(tpl).encode(); req=urllib.request.Request('http://localhost:9200/_template/soar_notifications',data=data,method='PUT',headers={'Content-Type':'application/json'}); urllib.request.urlopen(req,timeout=15); print('notifications template created')" 2>nul || echo [INFO] notifications template skipped
	@echo "  [8c] Starting remaining services..."
	$(DC) up -d --build
	@echo "==> [9/19] Configuring Elasticsearch index templates (replicas=0 for single-node)..."
	@powershell -NoProfile -Command "docker exec soar_api python /app/scripts/setup/configure_es.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@echo "==> [10/19] Waiting for Cortex and TheHive to initialize..."
	@powershell -NoProfile -Command "docker exec soar_api python /app/scripts/setup/reset_cortex.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@powershell -NoProfile -Command "docker exec soar_api python /app/scripts/setup/init_thehive.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@echo "==> [10b/19] Patching Cortex analyzer images (stdin fix)..."
	-@python infra/docker/images/cortex/patch_analyzers.py || echo [INFO] Analyzer patching skipped (non-fatal)
	@echo "==> [11/19] Restoring service credentials from backup (if available)..."
	-@docker exec soar_api python /app/scripts/setup/restore_credentials.py || echo [INFO] No credentials backup found or restoration failed
	@echo "==> [12/19] Running init_shuffle_webhook.py (installs apps + creates workflow)..."
	-@docker cp scripts/setup/shuffle_workflow/scripts/build_metrics_json.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/build_metrics_json.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/normalize_inputs.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/normalize_inputs.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/build_case_json.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/build_case_json.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/calc_decision.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/calc_decision.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/build_hive_summary.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/build_hive_summary.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/build_es_json.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/build_es_json.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/calc_mttr.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/calc_mttr.py 2>nul || true
	-@docker cp scripts/maintenance/clean_shuffle_executions.py soar_api:/app/scripts/maintenance/clean_shuffle_executions.py 2>nul || true
	-@docker cp scripts/maintenance/wait_for_workflows.py soar_api:/app/scripts/maintenance/wait_for_workflows.py 2>nul || true
	-@docker cp src/soar_lab/simulator/simulate_alerts.py soar_api:/app/src/soar_lab/simulator/simulate_alerts.py 2>nul || true
	@powershell -NoProfile -Command "$$ok=0; for ($$i=1; $$i -le 3; $$i++) { Write-Host \"Attempt $$i/3...\"; docker exec soar_api python /app/scripts/setup/init_shuffle_webhook.py; if ($$LASTEXITCODE -eq 0) { $$ok=1; break } Write-Host \"init_shuffle_webhook failed, retrying in 30s...\"; Start-Sleep -Seconds 30 }; if ($$ok -eq 0) { exit 1 }"
	@echo "==> [12b/19] Restarting API to pick up updated credentials..."
	-$(DC) restart api
	@powershell -NoProfile -Command "for ($$i=0; $$i -lt 30; $$i++) { $$r=docker exec soar_api curl -sf http://localhost:8000/health 2>&1; if ($$LASTEXITCODE -eq 0) { break } Start-Sleep -Seconds 2 }"
	@echo "==> [13/19] Copying webhook_info.json out of container..."
	-@docker cp soar_api:/app/reports/validation/results/webhook_info.json reports/validation/results/webhook_info.json 2>nul
	@echo "==> [14/19] Rewriting host-facing URLs in webhook_info.json..."
	@python scripts/setup/rewrite_webhook_info.py
	-@docker cp reports/validation/results/webhook_info.json soar_api:/app/reports/validation/results/webhook_info.json 2>nul
	@echo "==> [15/19] Setting up Cortex analyzers and MISP IOCs..."
	-@docker exec soar_api python /app/scripts/setup/setup_analyzers_and_iocs.py || echo [INFO] Analyzer/IOC setup completed with warnings
	@echo "==> [16/19] Setting up Grafana KPI dashboard..."
	-@python scripts/setup/setup_grafana_kpis.py || echo [INFO] Grafana KPI setup completed with warnings
	@echo "==> [17/19] Fixing Shuffle organization users..."
	-@docker exec soar_api python /app/scripts/setup/fix_org_users.py || echo [INFO] Org-user fix completed with warnings
	@echo ""
	@echo "==> [18/19] Refreshing Grafana to load updated datasources..."
	$(DC) up -d --no-deps --force-recreate grafana
	@echo "==> [19/19] Waiting for OpenSearch mappings to stabilize (30s)..."
	@powershell -NoProfile -Command "Start-Sleep -Seconds 30"
	@echo "==> Disabling OpenSearch replicas (single-node optimization)..."
	-@docker cp scripts/setup/disable_replicas.py soar_opensearch:/tmp/disable_replicas.py 2>nul || true
	-@docker exec soar_opensearch python3 /tmp/disable_replicas.py 2>nul || echo [INFO] Replica disable skipped
	@python scripts/setup/show_access.py

down:
	$(DC) down -v --remove-orphans
	@echo "Services stopped and volumes removed"

restart:
	$(DC) restart
	@echo "Services restarted"

logs:
	$(DC) logs -f

ps:
	$(DC) ps

health:
	@echo "Checking core service health..."
	@echo ""
	@echo "=== Core SOAR Services ==="
	@curl -sf http://localhost:19000/api/health && echo "✓ TheHive: OK" || echo "✗ TheHive: FAILED"
	@curl -sf http://localhost:19001/api/health && echo "✓ Cortex: OK" || echo "✗ Cortex: FAILED"
	@curl -sf http://localhost:15001/api/v1/health && echo "✓ Shuffle: OK" || echo "✗ Shuffle: FAILED"
	@curl -sf http://localhost:19200/_cluster/health && echo "✓ Elasticsearch: OK" || echo "✗ Elasticsearch: FAILED"
	@echo ""
	@echo "=== API & Management ==="
	@curl -sf http://localhost:8000/health && echo "✓ API: OK" || echo "✗ API: FAILED"
	@curl -sf http://localhost:8085 && echo "✓ Web Management: OK" || echo "✗ Web Management: FAILED"
	@echo ""
	@echo "=== Threat Intelligence ==="
	@curl -sf http://localhost:8083 && echo "✓ MISP: OK" || echo "✗ MISP: FAILED"
	@echo ""
	@echo "=== Observability ==="
	@curl -sf http://localhost:8084 && echo "✓ Grafana: OK" || echo "✗ Grafana: FAILED"
	@echo ""
	@echo "=== Infrastructure ==="
	@docker ps --filter name=soar_redis --format "{{.Status}}" | findstr "Up" >nul && echo "✓ Redis: OK" || echo "✗ Redis: FAILED"
	@docker ps --filter name=soar_nginx --format "{{.Status}}" | findstr "Up" >nul && echo "✓ Nginx: OK" || echo "✗ Nginx: FAILED"

init-webhook:
	@echo "Initializing Shuffle webhook..."
	@docker ps | findstr soar_shuffle_backend >nul || (echo ERROR: Shuffle backend is not running. Start services with 'make up' first && exit 1)
	docker exec soar_api python /app/scripts/setup/init_shuffle_webhook.py

clean-shuffle:
	@echo "Cleaning stale Shuffle executions from OpenSearch..."
	@docker ps | findstr soar_api >nul || (echo ERROR: soar_api is not running. Start services with 'make up' first && exit 1)
	docker exec soar_api python /app/scripts/maintenance/clean_shuffle_executions.py
	@echo "Shuffle cleanup complete."

clean-thehive:
	@echo "Cleaning old TheHive cases..."
	@docker ps | findstr soar_api >nul || (echo ERROR: soar_api is not running. Start services with 'make up' first && exit 1)
	docker exec soar_api python /app/scripts/maintenance/clean_thehive_cases.py
	@echo "TheHive cleanup complete."

# SIEM Simulation
SIMULATE_N ?= 5
SIMULATE_DELAY ?= 10
SIEM_PYTHON ?= python3

simulate:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	-@docker cp src/soar_lab/simulator/simulate_alerts.py soar_api:/app/src/soar_lab/simulator/simulate_alerts.py 2>nul || true
	@echo "==> Simulating ransomware attack ($(SIMULATE_N) malicious alerts)..."
	docker exec soar_api python3 -m soar_lab.simulator.simulate_alerts --count $(SIMULATE_N) --delay $(SIMULATE_DELAY)

simulate-malicious:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Sending malicious alert..."
	docker exec soar_api python3 -m soar_lab.simulator.simulate_alerts --count 1

simulate-benign:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Sending benign alert..."
	docker exec soar_api python3 -m soar_lab.simulator.simulate_alerts --count 1

simulate-batch:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	-@docker cp src/soar_lab/simulator/simulate_alerts.py soar_api:/app/src/soar_lab/simulator/simulate_alerts.py 2>nul || true
	@echo "==> Waiting 180s for Shuffle backend and OpenSearch to fully stabilize..."
	@powershell -NoProfile -Command "Start-Sleep -Seconds 180"
	@echo "==> Sending batch of $(or $(N),10) alerts..."
	docker exec soar_api python3 -m soar_lab.simulator.simulate_alerts --count $(or $(N),10) --delay $(SIMULATE_DELAY)

simulate-and-report: simulate-batch
	@echo "==> Waiting for all workflows to finish..."
	-@docker cp scripts/maintenance/wait_for_workflows.py soar_api:/app/scripts/maintenance/wait_for_workflows.py 2>nul || true
	docker exec soar_api python3 /app/scripts/maintenance/wait_for_workflows.py --expected $(or $(N),10) --timeout 600 --poll 10
	@echo "==> Generating report..."
	@$(MAKE) --no-print-directory -f Makefile.win test-e2e-report

# simulate-clean: clean stale executions, then simulate + report
# Use this to avoid Orborus re-executing stale workflows (which creates
# duplicate TheHive cases).  Stale = EXECUTING/ABORTED only; FINISHED
# executions are preserved for report statistics.
simulate-clean:
	@echo "==> Cleaning stale Shuffle executions (EXECUTING/ABORTED only)..."
	-@docker cp scripts/maintenance/clean_shuffle_executions.py soar_api:/app/scripts/maintenance/clean_shuffle_executions.py 2>nul || true
	-@docker exec soar_api python3 /app/scripts/maintenance/clean_shuffle_executions.py || echo [INFO] Clean completed with warnings
	@echo "==> Waiting 60s for Orborus to stabilize..."
	@powershell -NoProfile -Command "Start-Sleep -Seconds 60"
	@echo "==> Sending batch of $(or $(N),10) alerts (delay=$(SIMULATE_DELAY)s)..."
	-@docker cp src/soar_lab/simulator/simulate_alerts.py soar_api:/app/src/soar_lab/simulator/simulate_alerts.py 2>nul || true
	docker exec soar_api python3 -m soar_lab.simulator.simulate_alerts --count $(or $(N),10) --delay $(SIMULATE_DELAY)
	@echo "==> Waiting for all workflows to finish..."
	-@docker cp scripts/maintenance/wait_for_workflows.py soar_api:/app/scripts/maintenance/wait_for_workflows.py 2>nul || true
	docker exec soar_api python3 /app/scripts/maintenance/wait_for_workflows.py --expected $(or $(N),10) --timeout 600 --poll 10
	@echo "==> Generating report..."
	@$(MAKE) --no-print-directory -f Makefile.win test-e2e-report

# Metrics & Backup
metrics:
	@docker exec soar_api python /app/src/soar_lab/data/calc_kpis.py --output /app/reports/validation/results/kpis.csv
	@-docker cp soar_api:/app/reports/validation/results/kpis.csv reports/validation/results/kpis.csv 2>nul || echo [INFO] kpis.csv not found in container

backup:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	curl -sf -X POST http://localhost:8000/backup/create -H "Content-Type: application/json" -d '{"backup_name":"manual-backup.tar.gz"}' | python3 -m json.tool

restore:
	@if "$(BACKUP)"=="" (echo ERROR: BACKUP parameter required. Usage: make restore BACKUP=<backup_name> && echo Available backups: && dir runtime\backups 2>nul || echo No backups found && exit 1)
	@if not exist runtime\backups\$(BACKUP) (echo ERROR: Backup file runtime\backups\$(BACKUP) not found && exit 1)
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	curl -sf -X POST http://localhost:8000/backup/restore -H "Content-Type: application/json" -d '{"backup_name":"$(BACKUP)"}' | python3 -m json.tool

reset:
	@echo "==> [0/12] Backing up .env.full so it survives the reset..."
	@powershell -NoProfile -Command "if (Test-Path .env.full) { Copy-Item -Force .env.full .env.full.reset.bak }"
	@echo "==> [1/12] Preserving service credentials before reset..."
	-docker ps | findstr soar_api >nul && docker exec soar_api python /app/scripts/setup/preserve_credentials.py && docker cp soar_api:/app/reports/validation/results/credentials_backup.json reports/validation/results/credentials_backup.json || echo [INFO] API container not running, skipping credential preservation
	@echo "==> [2/12] Stopping project stack and removing project volumes..."
	-$(DC) down -v --remove-orphans
	@echo "==> [3/12] Force-removing any leftover soar_* containers..."
	-powershell -NoProfile -Command "docker ps -aq --filter name=soar_ | ForEach-Object { docker rm -f $$_ } 2>$$null"
	@echo "==> [4/12] Removing any leftover project Docker volumes..."
	-powershell -NoProfile -Command "docker volume ls -q | Where-Object { $$_ -match '^soar' -or $$_ -match '^soar-lab' } | ForEach-Object { docker volume rm $$_ } 2>$$null"
	@echo "==> [5/12] Removing any leftover project Docker networks..."
	-powershell -NoProfile -Command "docker network ls --format '{{.Name}}' | Where-Object { $$_ -match 'soar' -or $$_ -eq 'logging_net' -or $$_ -eq 'ti_net' } | ForEach-Object { docker network rm $$_ } 2>$$null"
	@echo "==> [6/12] Removing local runtime/data directories..."
	-powershell -NoProfile -Command "if (Test-Path runtime\data) { Remove-Item -Recurse -Force runtime\data -ErrorAction SilentlyContinue }"
	@echo "==> [7/12] Removing local runtime/logs directory..."
	-powershell -NoProfile -Command "if (Test-Path runtime\logs) { Remove-Item -Recurse -Force runtime\logs }"
	@echo "==> [8/12] Removing local runtime/backups directory..."
	-powershell -NoProfile -Command "if (Test-Path runtime\backups) { Remove-Item -Recurse -Force runtime\backups }"
	-powershell -NoProfile -Command "if (Test-Path runtime\results) { Remove-Item -Recurse -Force runtime\results }"
	-powershell -NoProfile -Command "if (Test-Path runtime\config) { Remove-Item -Recurse -Force runtime\config }"
	@echo "==> [9/12] Removing local reports/validation/results directory..."
	-powershell -NoProfile -Command "if (Test-Path reports\validation\results) { Remove-Item -Recurse -Force reports\validation\results }"
	@echo "==> [10/12] Removing local reports/coverage directory..."
	-powershell -NoProfile -Command "if (Test-Path reports\coverage) { Remove-Item -Recurse -Force reports\coverage }"
	@echo "==> [11/12] Restoring .env.full backup..."
	@powershell -NoProfile -Command "if (Test-Path .env.full.reset.bak) { Move-Item -Force .env.full.reset.bak .env.full } else { if (Test-Path .env.example) { Copy-Item -Force .env.example .env.full } }"
	@echo "==> [12/12] Reset complete. Run 'make up' to start fresh."

# Sync (copy src/tests into running container for dev without rebuild)
sync-src:
	@echo "src/ and pytest.ini are bind-mounted in docker-compose.api.yml — no sync needed"

sync-tests:
	@echo "tests/ is bind-mounted in docker-compose.api.yml — no sync needed"

# Testing
test-unit:
	@echo "Running unit tests with coverage inside Docker container..."
	docker exec soar_api python3 -m pytest tests/unit -v --cov=src/soar_lab --cov-report=term --cov-report=json:runtime/coverage/coverage.json --cov-report=html:artifacts/coverage/htmlcov --cov-report=xml:artifacts/coverage/coverage.xml --cov-fail-under=80
	-@docker exec soar_api cp /app/runtime/coverage/coverage.json /app/reports/coverage/coverage.json 2>nul || true

test-integration:
	@echo "Running integration tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/integration -v

test-e2e: clean-shuffle clean-thehive test-e2e-tc01 test-e2e-tc02 test-e2e-tc03 test-e2e-tc04 test-e2e-tc05 test-e2e-tc06 test-e2e-tc07 test-e2e-tc08 test-e2e-tc09 test-e2e-tc10 test-e2e-tc11 test-e2e-tc12 test-e2e-tc13 test-e2e-tc14 test-e2e-tc15 test-e2e-tc16 test-e2e-tc17 test-e2e-tc18 test-e2e-tc19 test-e2e-tc20 test-e2e-tc21 test-e2e-tc22 test-e2e-tc23 test-e2e-tc24 test-e2e-tc25 test-e2e-tc26 test-e2e-tc27 test-e2e-tc28 test-e2e-tc29 test-e2e-tc30 test-e2e-tc31 test-e2e-tc32 test-e2e-tc33 test-e2e-kpi-01 test-e2e-kpi-02 test-e2e-kpi-03 test-e2e-kpi-04 test-e2e-kpi-05
	@echo "All E2E tests completed. Generating report..."
	@$(MAKE) --no-print-directory -f Makefile.win test-e2e-report
	@echo "All E2E tests completed. Report at reports/e2e/e2e_report.md"

test-e2e-report:
	@echo "Generating E2E test report (MD + JSON + charts)..."
	@powershell -NoProfile -Command "if (!(Test-Path reports\e2e)) { New-Item -ItemType Directory -Force -Path reports\e2e }"
	-@docker cp scripts/reports/generate_e2e_report.py soar_api:/app/scripts/reports/generate_e2e_report.py 2>nul || true
	-@docker cp scripts/setup/shuffle_workflow/scripts/build_metrics_json.py soar_api:/app/scripts/setup/shuffle_workflow/scripts/build_metrics_json.py 2>nul || true
	-@docker cp scripts/maintenance/wait_for_workflows.py soar_api:/app/scripts/maintenance/wait_for_workflows.py 2>nul || true
	-@docker exec soar_api python3 /app/scripts/reports/generate_e2e_report.py --output-dir /app/reports/e2e
	-@docker cp soar_api:/app/reports/e2e/. reports/e2e/ 2>nul || true
	@echo "E2E report generated at reports/e2e/e2e_report.md"

