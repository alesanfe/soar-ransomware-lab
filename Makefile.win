	@echo "Running all new SOAR features tests..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-10 tests/e2e/TC-11 tests/e2e/TC-12 tests/e2e/TC-13 tests/e2e/TC-14 -v

test-atomic: sync-src sync-tests
	@echo "Running atomic operation tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/atomic -v --no-cov

test-smoke: sync-src sync-tests
	@echo "Running smoke tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/integration/test_smoke.py -v -m "smoke or smoke_critical or smoke_high or smoke_medium or requires_docker" --no-cov

test-security: sync-src sync-tests
	@echo "Running security tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/security -v --no-cov

test-performance: sync-src sync-tests
	@echo "Running performance tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/performance -v --no-cov

test-local: sync-src sync-tests
	@echo "Running fast local-only suites inside Docker container..."
	docker exec soar_api python3 -m pytest tests/unit tests/atomic tests/architecture -v --no-cov

test-integration-external test-external:
	@echo "Running external-service integration tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/integration -v -m "requires_external or requires_docker" --no-cov

test-docker: test-external

test-all: sync-src sync-tests
	@echo "Running ALL tests (unit + integration + e2e) inside Docker container..."
	docker exec soar_api python3 -m pytest tests/ -v -m "requires_docker or not requires_docker"

test-coverage: sync-src sync-tests
	@echo "Running tests with coverage report inside Docker container..."
	docker exec soar_api python3 -m pytest tests/ -m "requires_docker or not requires_docker" --ignore=tests/e2e --cov=src/soar_lab --cov-report=html --cov-report=xml --cov-report=json:runtime/coverage/coverage.json --cov-report=term --cov-fail-under=80
	-@docker exec soar_api cp -r /app/htmlcov /app/reports/coverage/ 2>nul
	-@docker exec soar_api cp /app/coverage.xml /app/reports/coverage/ 2>nul
	-@docker exec soar_api cp /app/runtime/coverage/coverage.json /app/reports/coverage/coverage.json 2>nul

test-docker-runtime:
	@echo "Running Docker runtime status tests..."
	@set PYTHONPATH=src&& python3 -m pytest tests/integration/test_docker_runtime_status.py -v

# Maintenance
deps:
	@echo "Installing Python dependencies..."
	python -m pip install -e .

deps-test:
	@echo "Installing test dependencies..."
	python -m pip install -e ".[dev,test]"

deps-lint:
	@echo "Installing linter dependencies (ruff, black, isort, flake8, mypy, vulture, bandit, radon)..."
	python -m pip install -e ".[dev]"
	python -m pip install ruff vulture bandit radon flake8-docstrings flake8-bandit flake8-bugbear flake8-comprehensions
	python -m pip install flake8-quotes flake8-isort flake8-mypy flake8-pytest-style pydoclint flake8-pyproject
	python -m pip install pylint interrogate pip-audit detect-secrets xenon
	@echo "==> Linter dependencies installed!"

generate-secrets:
	@echo "Generating secure passwords/tokens..."
	@python scripts/setup/generate_env.py

scan-secrets:
	@echo "Scanning repo, container logs and images for exposed secrets..."
	@python scripts/quality/scan_secrets.py --mode all

test-report:
	@echo "Generating unified test summary (reports/test-summary/)..."
	@python scripts/reports/test_summary.py

check-grafana:
	@echo "Validating Grafana provisioning..."
	@python scripts/quality/check_grafana_provisioning.py

check-ui-inventory:
	@echo "Validating UI inventory vs published compose ports..."
	@python scripts/quality/check_ui_inventory.py

check-doc-links:
	@echo "Checking documentation links and anchors..."
	@python scripts/quality/check_doc_links.py

test-e2e-a11y:
	@python -m pytest tests/e2e/TC-28/test_ui_a11y.py -v -c pytest.ini --no-cov -m "requires_docker or not requires_docker"

export-cacao:
	@echo "Exporting workflow to CACAO 2.0 (reports/cacao/)..."
	@python scripts/quality/export_cacao.py

export-stix:
	@echo "Exporting ATT&CK coverage to STIX 2.1 (reports/stix/)..."
	@python scripts/quality/export_attack_stix.py

generate-iocs:
	@echo "Generating simulated IOCs..."
	@set PYTHONPATH=src&& python3 -m soar_lab.interfaces.api.cli generate-iocs

certs:
	@echo "Generating TLS certificates for Nginx..."
	@powershell -NoProfile -Command "if (!(Test-Path infra\docker\config\nginx\ssl)) { New-Item -ItemType Directory -Force -Path infra\docker\config\nginx\ssl }"
	@set CERT_DIR=infra/docker/config/nginx/ssl&& bash scripts/setup/gen_certs.sh soar.local

# Cleanup
clean:
	@echo "Cleaning temporary files..."
	@powershell -NoProfile -Command "foreach ($$p in @('reports/validation/results','reports/coverage','.pytest_cache','.coverage','coverage.xml','htmlcov')) { if (Test-Path $$p) { Remove-Item -Recurse -Force $$p } }; if (Test-Path runtime/logs/*.log) { Remove-Item -Force runtime/logs/*.log }"

# Maintenance Commands
logs-service:
	@if "$(SERVICE)"=="" (echo ERROR: SERVICE parameter required. Usage: make logs-service SERVICE=<service_name> && exit 1)
	@echo "Viewing logs for service: $(SERVICE)"
	$(DC) logs -f $(SERVICE)

# Development Commands
dev-reload: sync-src
	@echo "Reloading code in API container without rebuild..."
	$(DC) up -d --no-deps --force-recreate api

dev-shell:
	@echo "Opening shell in API container..."
	docker exec -it soar_api /bin/bash

dev-debug:
	@echo "Starting API in debug mode..."
	$(DC) up -d --no-deps --force-recreate api
	docker exec -it soar_api python -m debugpy --listen 0.0.0.0:5678 --wait-for-client -m uvicorn soar_lab.interfaces.api:app --host 0.0.0.0 --port 8000 --reload

# Documentation Commands
docs-build:
	@echo "Building documentation..."
	docker exec soar_api python -m sphinx -b html docs/ reports/docs/

docs-serve:
	@echo "Serving documentation at http://localhost:8001..."
	-@docker rm -f soar_docs_serve >nul 2>&1
	docker run -d --name soar_docs_serve -p 8001:8001 -v $(CURDIR)/reports/docs:/usr/share/nginx/html nginx:alpine

docs-lint:
	@echo "==> Running docs-lint (all doc linters + doc generation)..."
	@echo "  1. markdownlint"
	-@where markdownlint >nul 2>&1 && (markdownlint docs/ || echo "  markdownlint reported issues (non-blocking)") || echo "  markdownlint not installed, skipping"
	@echo "  2. link-checker (lychee)"
	-@where lychee >nul 2>&1 && (lychee --quiet docs/ || echo "  lychee reported issues (non-blocking)") || echo "  lychee not installed, skipping"
	@echo "  3. docs_quality.py (OpenAPI diff + banned patterns + test inventory)"
	python3 scripts/ci/docs_quality.py
	@echo "  4. pytest collect-only"
	python3 -m pytest --collect-only -q
	@echo "  5. Generate documentation (Sphinx HTML)"
	-@powershell -NoProfile -Command "if (!(Test-Path reports\docs)) { New-Item -ItemType Directory -Force -Path reports\docs }"
	-@python3 -m sphinx -b html docs/ reports/docs/ 2>nul || echo "  Sphinx not available locally, trying Docker..."
	-@docker ps | findstr soar_api >nul 2>&1 && docker exec soar_api python -m sphinx -b html docs/ reports/docs/ || echo "  Docker not running, skipping Sphinx build"
	@echo "==> docs-lint complete!"

# Code quality — single lint target runs ALL linters inline
lint:
	@echo ""
	@echo "=========================================================="
	@echo "  Full lint suite (31 tools) -> reports/quality/lint-report.md"
	@echo "=========================================================="
	@python3 scripts/quality/run_linters.py --gate
	@echo ""
	@echo "=========================================================="
	@echo "  docs-lint - doc linters + docs generation"
	@echo "=========================================================="
	@$(MAKE) --no-print-directory docs-lint

quality:
	@echo "==> Running quality checks (scripts/quality/)..."
	@powershell -NoProfile -Command "if (!(Test-Path reports\quality)) { New-Item -ItemType Directory -Force -Path reports\quality }"
	@powershell -NoProfile -Command "if (!(Test-Path reports\coverage\coverage.xml)) { Write-Host '  Coverage XML not found, generating...'; python -m pytest tests/unit tests/atomic tests/architecture --cov=src/soar_lab --cov-branch --cov-report=xml:reports/coverage/coverage.xml --cov-report=json:reports/coverage/coverage.json -q --tb=no 2>nul }"
	@python3 scripts/quality/run_quality_checks.py --output-dir reports/quality
	@echo "==> Quality checks passed! Report at reports/quality/quality-summary.md"

mutation:
	@echo "==> Running mutation testing (mutmut) in Docker..."
	@echo "    This mutates src/soar_lab/ and runs tests for each mutant."
	@echo "    Estimated time: 60-180 min depending on hardware."
	@powershell -NoProfile -Command "if (!(Test-Path reports\mutmut)) { New-Item -ItemType Directory -Force -Path reports\mutmut }"
	-@docker exec soar_api python -m pip install --quiet mutmut 2>nul
	@docker exec soar_api python scripts/reports/generate_mutmut_report.py --output-dir reports/mutmut
	@if exist reports\mutmut\mutation_report.md (echo ==> Mutation report generated: reports/mutmut/mutation_report.md) else (echo ==> Report not found. Check Docker container logs. && exit 1)

test-review:
	@echo "==> Generating test review report (7-dimension methodology)..."
	@powershell -NoProfile -Command "if (!(Test-Path reports\test-review)) { New-Item -ItemType Directory -Force -Path reports\test-review }"
	@python3 scripts/reports/test_review.py --output-dir reports/test-review --with-coverage
	@echo "==> Test review report: reports/test-review/test_review_report.md"

holistic-review:
	@echo "==> Running Holistic Project Radar (5 layers, 15 dimensions)..."
	@powershell -NoProfile -Command "if (!(Test-Path reports\holistic)) { New-Item -ItemType Directory -Force -Path reports\holistic }"
	@python3 scripts/reports/holistic_review.py --output-dir reports/holistic
	@echo "==> Holistic review report: reports/holistic/holistic_review_report.md"

audit-report:
	@echo "==> Refreshing live audit ficha (docs/16 AUDIT-LIVE block)..."
	@powershell -NoProfile -Command "if (!(Test-Path reports\audit)) { New-Item -ItemType Directory -Force -Path reports\audit }"
	@python3 scripts/reports/generate_audit_report.py
	@echo "==> Audit context: reports/audit/audit_context.json"

e2e-lint:
	@echo "==> E2E oracle audit (13 categories, machine-readable)..."
	@python3 scripts/quality/e2e_oracle_audit.py --baseline tests/e2e/oracle_baseline.json
	@echo "==> Ratchet lint gate (3 tests, --no-cov: static analysis needs no coverage)..."
	@docker exec soar_api python3 -m pytest tests/integration/test_e2e_lint.py -v --no-cov
	@echo "==> E2E lint gate passed"

build-dataset:
	@echo "==> Regenerating anonymized publishable dataset (deterministic, seed-anchored)..."
	@python3 scripts/maintenance/build_dataset.py
	@echo "==> Verify: sha256 of datasets/soar-ransomware-alerts-v1.jsonl == MANIFEST.json jsonl_sha256"

evidence-score:
	@echo "==> Scoring E2E evidence packages (EVID-003)..."
	@python3 scripts/quality/score_evidence.py --results reports/validation/results --out reports/validation/evidence-score.json --history reports/validation/evidence-score-history.jsonl
	@python3 -c "import json; s=json.load(open('reports/validation/evidence-score.json'))['summary']; print('mean=%(mean_score)s verdict=%(verdict)s packages=%(packages)s' % s)"

load-report:
	@echo "==> Locust headless load profile -> reports/perf/load_report.json (PERF)"
	@echo "    NOTE: run when the stack is idle - each admission creates a real Shuffle execution."
	@python3 scripts/perf/run_load_report.py --host http://localhost:8000 --users 60 --spawn-rate 10 --duration 5m

chaos-campaign:
	@echo "==> Chaos campaign: multi-fault injection with recovery evidence (RES-02)"
	@echo "    NOTE: pauses containers mid-workflow — run on idle stack, not during e2e."
	@python3 scripts/perf/chaos_campaign.py


lint-fix:
	@echo "==> Auto-fixing code with ruff, black and isort..."
	@python3 -m ruff check --fix src/ tests/ scripts/setup/
	@python3 -m ruff format src/ tests/ scripts/setup/
	@python3 -m black src/ tests/
	@python3 -m isort src/ tests/
	@echo "==> Lint fix complete!"

test-e2e-tc11-12: sync-src sync-tests
	@echo "Running TC-11 (12/13): test_network_destination..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-11/test_network_watcher_integration.py::TestNetworkWatcherIntegration::test_network_destination" -v

test-e2e-tc11-13: sync-src sync-tests
	@echo "Running TC-11 (13/13): test_network_correlation..."
	docker exec soar_api python3 -m pytest "tests/e2e/TC-11/test_network_watcher_integration.py::TestNetworkWatcherIntegration::test_network_correlation" -v
