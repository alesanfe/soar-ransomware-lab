
PROJECT  := soar
COMPOSE_FILES := -f infra/docker/compose/docker-compose.yml \
                 -f infra/docker/compose/docker-compose.core.yml \
                 -f infra/docker/compose/docker-compose.misp.yml \
                 -f infra/docker/compose/docker-compose.wazuh.yml \
                 -f infra/docker/compose/docker-compose.opensearch.yml \
                 -f infra/docker/compose/docker-compose.api.yml \
                 -f infra/docker/compose/logging/docker-compose.logging.yml
export ARTIFACTS_DIR := $(CURDIR)/artifacts
DC := docker compose -p $(PROJECT) $(COMPOSE_FILES) --env-file .env

.PHONY: help install install-dev
.PHONY: up down restart logs ps health
.PHONY: test-unit test-integration test-e2e test-atomic test-security test-performance test-all test-coverage
.PHONY: test-e2e-tc01 test-e2e-tc02 test-e2e-tc10 test-e2e-tc11 test-e2e-tc12 test-e2e-tc13 test-e2e-tc14
.PHONY: test-e2e-new-features
.PHONY: metrics backup restore
.PHONY: clean clean-full clean-all clean-docker reset
.PHONY: certs deps deps-test generate-secrets check-deps validate-credentials
.PHONY: simulate simulate-malicious simulate-benign simulate-batch
.PHONY: vagrant-up vagrant-down vagrant-provision vagrant-reload vagrant-ssh vagrant-status vagrant-logs vagrant-ubuntu vagrant-windows vagrant-simulate
.PHONY: init-webhook

help:
	@echo "=========================================="
	@echo "  SOAR Ransomware Lab - Windows Makefile"
	@echo "=========================================="
	@echo ""
	@echo "[Service Management]"
	@echo "  make up            - Start all SOAR services (Docker stack)"
	@echo "  make down          - Stop services and remove volumes"
	@echo "  make restart       - Restart all services"
	@echo "  make logs          - View service logs (follow mode)"
	@echo "  make ps            - Show running containers status"
	@echo "  make health        - Check health of core services"
	@echo "  make init-webhook  - Initialize Shuffle webhook for alerts"
	@echo ""
	@echo "[Testing]"
	@echo "  make test-unit        - Run unit tests only"
	@echo "  make test-integration - Run integration tests"
	@echo "  make test-e2e         - Run all E2E tests"
	@echo "  make test-e2e-tc01    - Run TC-01: Malicious IOC detection"
	@echo "  make test-e2e-tc02    - Run TC-02: Benign IOC verification"
	@echo "  make test-atomic     - Run atomic operation tests"
	@echo "  make test-security   - Run security tests"
	@echo "  make test-performance- Run performance tests"
	@echo "  make test-all        - Run ALL tests (unit + integration + e2e)"
	@echo "  make test-coverage   - Run tests with coverage report"
	@echo ""
	@echo "[SIEM Simulation]"
	@echo "  make simulate            - Simulate ransomware attack (5 alerts)"
	@echo "  make simulate-malicious  - Send 1 malicious alert"
	@echo "  make simulate-benign     - Send 1 benign alert"
	@echo "  make simulate-batch N=10 - Send N alerts (default: 10)"
	@echo ""
	@echo "[Vagrant (Multi-VM Environment)]"
	@echo "  make vagrant-up       - Start / create Ubuntu SOAR VM"
	@echo "  make vagrant-provision- Re-provision running Ubuntu SOAR VM"
	@echo "  make vagrant-reload   - Reload and re-provision Ubuntu SOAR VM"
	@echo "  make vagrant-ssh      - SSH into Ubuntu SOAR VM"
	@echo "  make vagrant-status   - Show Vagrant VM status"
	@echo "  make vagrant-logs     - Tail relevant logs inside the Ubuntu VM"
	@echo "  make vagrant-ubuntu   - Start Ubuntu SOAR VM only"
	@echo "  make vagrant-windows  - Start Windows victim VM (disabled - incompatible)"
	@echo "  make vagrant-down     - Destroy all VMs"
	@echo "  make vagrant-simulate - Simulate attack from Ubuntu VM (Python simulator)"
	@echo ""
	@echo "[Maintenance]"
	@echo "  make deps               - Install Python dependencies"
	@echo "  make deps-test          - Install test dependencies"
	@echo "  make generate-secrets   - Generate secure passwords/tokens"
	@echo "  make certs              - Generate TLS certificates for Nginx"
	@echo "  make metrics            - Calculate KPIs from logs"
	@echo "  make backup             - Create backup of artifacts"
	@echo "  make restore            - Restore from backup (BACKUP=<name>)"
	@echo "  make check-deps         - Verify all dependencies are installed"
	@echo "  make reset              - Full reset: destroy all containers, volumes, networks"
	@echo ""
	@echo "[Quick Start]"
	@echo "  1. make up                    # Start SOAR stack"
	@echo "  2. make init-webhook          # Initialize webhook"
	@echo "  3. make simulate              # Test with sample alert"
	@echo "  4. make test-e2e-tc01         # Run malicious IOC tests"
	@echo ""
	@echo "[For Vagrant environment]"
	@echo "  1. make vagrant-up            # Start Ubuntu SOAR VM"
	@echo "  2. make vagrant-simulate      # Simulate attack from Ubuntu VM"

install:
	pip install -e .

install-dev:
	pip install -e ".[dev]"

# Service Management
validate-credentials:
	@echo "Validating credential synchronization..."
	@if not exist .env.full (echo ERROR: .env.full not found. Please create it from .env.example && exit 1)
	@python src/soar_lab/infrastructure/validate_credentials.py

up:
	@echo "Checking .env.full exists..."
	@powershell -Command "if (!(Test-Path .env.full)) { if (Test-Path .env.full.reset.bak) { Move-Item -Force .env.full.reset.bak .env.full } elseif (Test-Path .env.example) { Copy-Item -Force .env.example .env.full } else { Write-Host 'ERROR: .env.full and .env.example are missing'; exit 1 } }"
	@echo "Generating local .env for Docker Desktop with project-local ARTIFACTS_DIR..."
	@python -c "import pathlib; s=pathlib.Path('.env.full').read_text(encoding='utf-8'); a=str(pathlib.Path('artifacts').resolve()).replace('\\','/'); pathlib.Path('.env').write_text('\n'.join([f'ARTIFACTS_DIR={a}' if l.startswith('ARTIFACTS_DIR=') else l for l in s.splitlines()]), encoding='utf-8')"
	@echo "Creating Docker networks with compose labels (if not exist)..."
	@docker network inspect soar_net >nul 2>&1 || docker network create --label "com.docker.compose.network=soar_net" --label "com.docker.compose.project=soar" soar_net
	@docker network inspect logging_net >nul 2>&1 || docker network create --label "com.docker.compose.network=logging_net" --label "com.docker.compose.project=soar" logging_net
	@docker network inspect ti_net >nul 2>&1 || docker network create --label "com.docker.compose.network=ti_net" --label "com.docker.compose.project=soar" ti_net
	@echo "Creating required directories..."
	@powershell -Command "if (!(Test-Path 'artifacts\data\elasticsearch')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\elasticsearch' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\thehive\files')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\thehive\files' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\cortex')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\cortex' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\shuffle\apps')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\shuffle\apps' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\shuffle\files')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\shuffle\files' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\redis')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\redis' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\misp\db')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\misp\db' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\misp\files')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\misp\files' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\misp\configs')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\misp\configs' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\misp\logs')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\misp\logs' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\config')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\config' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\api_config')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\api_config' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\etc')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\etc' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\queue')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\queue' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\var_multigroups')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\var_multigroups' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\integration_files')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\integration_files' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\active_response')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\active_response' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\wodles')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\wodles' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\wazuh\logs')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\wazuh\logs' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\kibana')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\kibana' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\loki')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\loki' }"
	@powershell -Command "if (!(Test-Path 'artifacts\data\grafana')) { New-Item -ItemType Directory -Force -Path 'artifacts\data\grafana' }"
	@powershell -Command "if (!(Test-Path 'artifacts\backups')) { New-Item -ItemType Directory -Force -Path 'artifacts\backups' }"
	@powershell -Command "if (!(Test-Path 'artifacts\logs')) { New-Item -ItemType Directory -Force -Path 'artifacts\logs' }"
	@powershell -Command "if (!(Test-Path 'artifacts\results')) { New-Item -ItemType Directory -Force -Path 'artifacts\results' }"
	@powershell -Command "if (!(Test-Path 'artifacts\coverage')) { New-Item -ItemType Directory -Force -Path 'artifacts\coverage' }"
	@echo "Updating Wazuh password hashes before containers start..."
	@python src/soar_lab/scripts/setup/update_wazuh_hashes.py
	@echo "Seeding Wazuh default configuration..."
	@python src/soar_lab/scripts/setup/seed_wazuh.py
	$(DC) up -d --build
	@echo "Services started — configuring Elasticsearch index templates (replicas=0 for single-node)..."
	@powershell -Command "docker exec soar_api python /app/src/soar_lab/scripts/setup/configure_es.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@echo "Waiting for Cortex and TheHive to initialize..."
	@powershell -Command "docker exec soar_api python /app/src/soar_lab/scripts/setup/reset_cortex.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@powershell -Command "docker exec soar_api python /app/src/soar_lab/scripts/setup/init_thehive.py; if ($$LASTEXITCODE -ne 0) { exit 1 }"
	@echo "Restoring service credentials from backup (if available)..."
	-@docker exec soar_api python /app/src/soar_lab/scripts/setup/restore_credentials.py || echo [INFO] No credentials backup found or restoration failed
	@echo "Running init_shuffle_webhook.py (installs apps + creates workflow)..."
	@powershell -Command "$$ok=0; for ($$i=1; $$i -le 3; $$i++) { Write-Host \"Attempt $$i/3...\"; docker exec soar_api python /app/src/soar_lab/scripts/setup/init_shuffle_webhook.py; if ($$LASTEXITCODE -eq 0) { $$ok=1; break } Write-Host \"init_shuffle_webhook failed, retrying in 30s...\"; Start-Sleep -Seconds 30 }; if ($$ok -eq 0) { exit 1 }"
	@echo "Copying webhook_info.json out of container..."
	-@docker cp soar_api:/app/webhook_info.json artifacts/results/webhook_info.json 2>nul
	@echo "Rewriting host-facing URLs in webhook_info.json..."
	@python src/soar_lab/scripts/setup/rewrite_webhook_info.py
	-@docker cp artifacts/results/webhook_info.json soar_api:/app/webhook_info.json 2>nul
	@echo "Setting up Cortex analyzers and MISP IOCs..."
	-@docker exec soar_api python /app/src/soar_lab/scripts/setup/setup_analyzers_and_iocs.py || echo [INFO] Analyzer/IOC setup completed with warnings
	@echo "Setting up Grafana KPI dashboard..."
	-@python src/soar_lab/scripts/setup/setup_grafana_kpis.py || echo [INFO] Grafana KPI setup completed with warnings
	@echo "Fixing Shuffle organization users..."
	-@docker exec soar_api python /app/src/soar_lab/scripts/setup/fix_org_users.py || echo [INFO] Org-user fix completed with warnings

down:
	$(DC) down -v --remove-orphans
	@echo "Services stopped and volumes removed"

restart:
	$(DC) restart
	@echo "Services restarted"

logs:
	$(DC) logs -f

ps:
	$(DC) ps

health:
	@echo "Checking core service health..."
	@echo ""
	@echo "=== Core SOAR Services ==="
	@curl -sf http://localhost:19000/api/health && echo "✓ TheHive: OK" || echo "✗ TheHive: FAILED"
	@curl -sf http://localhost:19001/api/health && echo "✓ Cortex: OK" || echo "✗ Cortex: FAILED"
	@curl -sf http://localhost:15001/api/v1/health && echo "✓ Shuffle: OK" || echo "✗ Shuffle: FAILED"
	@curl -sf http://localhost:19200/_cluster/health && echo "✓ Elasticsearch: OK" || echo "✗ Elasticsearch: FAILED"
	@echo ""
	@echo "=== API & Management ==="
	@curl -sf http://localhost:8000/health && echo "✓ API: OK" || echo "✗ API: FAILED"
	@curl -sf http://localhost:8085 && echo "✓ Web Management: OK" || echo "✗ Web Management: FAILED"
	@echo ""
	@echo "=== Threat Intelligence ==="
	@curl -sf http://localhost:8083 && echo "✓ MISP: OK" || echo "✗ MISP: FAILED"
	@echo ""
	@echo "=== Observability ==="
	@curl -sf http://localhost:15601/kibana/api/status && echo "✓ Wazuh Dashboard: OK" || echo "✗ Wazuh Dashboard: FAILED"
	@curl -sf http://localhost:8084 && echo "✓ Grafana: OK" || echo "✗ Grafana: FAILED"
	@echo ""
	@echo "=== Infrastructure ==="
	@docker ps --filter name=soar_redis --format "{{.Status}}" | findstr "Up" >nul && echo "✓ Redis: OK" || echo "✗ Redis: FAILED"
	@docker ps --filter name=soar_nginx --format "{{.Status}}" | findstr "Up" >nul && echo "✓ Nginx: OK" || echo "✗ Nginx: FAILED"

init-webhook:
	@echo "Initializing Shuffle webhook..."
	@docker ps | findstr soar_shuffle_backend >nul || (echo ERROR: Shuffle backend is not running. Start services with 'make up' first && exit 1)
	docker exec soar_api python /app/src/soar_lab/scripts/setup/init_shuffle_webhook.py

# SIEM Simulation
SIMULATE_N ?= 5
SIMULATE_DELAY ?= 3
SIEM_PYTHON ?= python3

simulate:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Simulating ransomware attack ($(SIMULATE_N) malicious alerts)..."
	$(SIEM_PYTHON) -m soar_lab.services.send_alert --type malicious --num-alerts $(SIMULATE_N) --delay $(SIMULATE_DELAY)

simulate-malicious:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Sending malicious alert..."
	$(SIEM_PYTHON) -m soar_lab.services.send_alert --type malicious --single

simulate-benign:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Sending benign alert..."
	$(SIEM_PYTHON) -m soar_lab.services.send_alert --type benign --single

simulate-batch:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	@echo "==> Sending batch of $(or $(N),10) alerts..."
	$(SIEM_PYTHON) -m soar_lab.services.send_alert --type malicious --num-alerts $(or $(N),10) --delay $(SIMULATE_DELAY)

# Vagrant targets
vagrant-up:
	cd infra/vagrant && vagrant up --provision

vagrant-provision:
	cd infra/vagrant && vagrant up --provision

vagrant-reload:
	cd infra/vagrant && vagrant reload --provision

vagrant-ssh:
	cd infra/vagrant && vagrant ssh soar-ubuntu

vagrant-status:
	cd infra/vagrant && vagrant status

vagrant-logs:
	cd infra/vagrant && vagrant ssh soar-ubuntu -c "sudo tail -n 50 /opt/soar-ransomware-lab/artifacts/logs/notify.log 2>/dev/null || true; sudo docker logs --tail 50 soar_api 2>/dev/null || true"

vagrant-ubuntu:
	cd infra/vagrant && vagrant up soar-ubuntu

vagrant-windows:
	cd infra/vagrant && vagrant up victima-windows

vagrant-down:
	cd infra/vagrant && vagrant destroy -f

vagrant-simulate:
	@echo "Simulating ransomware alerts from Ubuntu VM (Windows VM disabled)..."
	cd infra/vagrant && vagrant ssh soar-ubuntu -- "sudo docker cp /opt/soar-ransomware-lab/infra/vagrant/simulate_alerts.py soar_api:/tmp/simulate_alerts.py && sudo docker exec soar_api python3 /tmp/simulate_alerts.py --count 5 --delay 2 || true"

# Metrics & Backup
metrics:
	@set PYTHONPATH=src&& set ELASTICSEARCH_URL=http://localhost:19200&& set ELASTIC_PASSWORD=ElasticLab2024SecurePass&& set ELASTIC_USER=elastic&& python3 src\soar_lab\data\calc_kpis.py --output artifacts\results\kpis.csv

# Data Analysis Commands
data-status:
	@echo "Checking data availability status..."
	@powershell -Command "if (Test-Path artifacts\results) { Get-ChildItem artifacts\results | Select-Object Name, Length } else { Write-Host 'No artifacts found - run tests first' }"
	@powershell -Command "if (Test-Path artifacts\logs) { Get-ChildItem artifacts\logs | Select-Object Name, Length } else { Write-Host 'No logs found' }"

data-generate:
	@echo "Generating complete analysis data..."
	@set PYTHONPATH=src&& set ELASTICSEARCH_URL=http://localhost:19200&& set ELASTIC_PASSWORD=ElasticLab2024SecurePass&& set ELASTIC_USER=elastic&& python3 src\soar_lab\data\calc_kpis.py --output artifacts\results\kpis.csv

data-view:
	@echo "Viewing all available data..."
	@powershell -Command "if (Test-Path artifacts\results\kpis.csv) { Get-Content artifacts\results\kpis.csv } else { Write-Host 'No kpis.csv found - run make metrics first' }"
	@powershell -Command "if (Test-Path artifacts\results) { Get-ChildItem artifacts\results\*.json -ErrorAction SilentlyContinue | Select-Object Name } else { Write-Host 'No JSON reports found' }"

data-watch:
	@echo "Monitoring data changes in real-time..."
	@powershell -Command "if (Test-Path artifacts\logs\notify.log) { Get-Content artifacts\logs\notify.log -Wait -Tail 50 } else { Write-Host 'No notify.log found - run tests first' }"

backup:
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	curl -sf -X POST http://localhost:8000/backup/create -H "Content-Type: application/json" -d '{"backup_name":"manual-backup.tar.gz"}' | python3 -m json.tool

restore:
	@if "$(BACKUP)"=="" (echo ERROR: BACKUP parameter required. Usage: make restore BACKUP=<backup_name> && echo Available backups: && dir artifacts\backups 2>nul || echo No backups found && exit 1)
	@if not exist artifacts\backups\$(BACKUP) (echo ERROR: Backup file artifacts\backups\$(BACKUP) not found && exit 1)
	@curl -sf http://localhost:8000/health >nul 2>&1 || (echo ERROR: API not available. Start services with 'make up' first && exit 1)
	curl -sf -X POST http://localhost:8000/backup/restore -H "Content-Type: application/json" -d '{"backup_name":"$(BACKUP)"}' | python3 -m json.tool

reset:
	@echo "==> [0/12] Backing up .env.full so it survives the reset..."
	@powershell -Command "if (Test-Path .env.full) { Copy-Item -Force .env.full .env.full.reset.bak }"
	@echo "==> [1/12] Preserving service credentials before reset..."
	-docker ps | findstr soar_api >nul && docker exec soar_api python /app/src/soar_lab/scripts/setup/preserve_credentials.py && docker cp soar_api:/app/src/soar_lab/infrastructure/artifacts/credentials_backup.json src/soar_lab/infrastructure/artifacts/credentials_backup.json || echo [INFO] API container not running, skipping credential preservation
	@echo "==> [2/12] Stopping project stack and removing project volumes..."
	-$(DC) down -v --remove-orphans
	@echo "==> [3/12] Force-removing any leftover soar_* containers..."
	-powershell -Command "docker ps -aq --filter name=soar_ | ForEach-Object { docker rm -f $$_ } 2>$$null"
	@echo "==> [4/12] Removing any leftover project Docker volumes..."
	-powershell -Command "docker volume ls -q | Where-Object { $$_ -match '^soar' -or $$_ -match '^soar-lab' } | ForEach-Object { docker volume rm $$_ } 2>$$null"
	@echo "==> [5/12] Removing any leftover project Docker networks..."
	-powershell -Command "docker network ls --format '{{.Name}}' | Where-Object { $$_ -match 'soar' -or $$_ -eq 'logging_net' -or $$_ -eq 'ti_net' } | ForEach-Object { docker network rm $$_ } 2>$$null"
	@echo "==> [6/12] Removing local artifacts/data directories..."
	-powershell -Command "if (Test-Path artifacts\data) { Remove-Item -Recurse -Force artifacts\data -ErrorAction SilentlyContinue }"
	@echo "==> [7/12] Removing local artifacts/logs directory..."
	-powershell -Command "if (Test-Path artifacts\logs) { Remove-Item -Recurse -Force artifacts\logs }"
	@echo "==> [8/12] Removing local artifacts/backups directory..."
	-powershell -Command "if (Test-Path artifacts\backups) { Remove-Item -Recurse -Force artifacts\backups }"
	@echo "==> [9/12] Removing local artifacts/results directory..."
	-powershell -Command "if (Test-Path artifacts\results) { Remove-Item -Recurse -Force artifacts\results }"
	@echo "==> [10/12] Removing local artifacts/coverage directory..."
	-powershell -Command "if (Test-Path artifacts\coverage) { Remove-Item -Recurse -Force artifacts\coverage }"
	@echo "==> [11/12] Restoring .env.full backup..."
	@powershell -Command "if (Test-Path .env.full.reset.bak) { Move-Item -Force .env.full.reset.bak .env.full } else { if (Test-Path .env.example) { Copy-Item -Force .env.example .env.full } }"
	@echo "==> [12/12] Reset complete. Run 'make up' to start fresh."

# Testing
test-unit:
	@echo "Running unit tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/unit -v

test-integration:
	@echo "Running integration tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/integration -v

test-e2e:
	@echo "Running E2E tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/e2e -v --no-cov

test-e2e-tc01:
	@echo "Running TC-01: Malicious IOC detection..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-01 -v

test-e2e-tc02:
	@echo "Running TC-02: Benign IOC verification..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-02 -v

test-e2e-tc10:
	@echo "Running TC-10: Tenzir integration..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-10 -v

test-e2e-tc11:
	@echo "Running TC-11: Network Watcher integration..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-11 -v

test-e2e-tc12:
	@echo "Running TC-12: Redis integration..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-12 -v

test-e2e-tc13:
	@echo "Running TC-13: Loki integration..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-13 -v

test-e2e-tc14:
	@echo "Running TC-14: Complete SOAR integration..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-14 -v

test-e2e-new-features:
	@echo "Running all new SOAR features tests..."
	docker exec soar_api python3 -m pytest tests/e2e/TC-10 tests/e2e/TC-11 tests/e2e/TC-12 tests/e2e/TC-13 tests/e2e/TC-14 -v

test-atomic:
	@echo "Running atomic operation tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/atomic -v

test-security:
	@echo "Running security tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/security -v

test-performance:
	@echo "Running performance tests inside Docker container..."
	docker exec soar_api python3 -m pytest tests/performance -v

test-all:
	@echo "Running ALL tests (unit + integration + e2e) inside Docker container..."
	docker exec soar_api python3 -m pytest tests/ -v

test-coverage:
	@echo "Running tests with coverage report inside Docker container..."
	docker exec soar_api python3 -m pytest tests/ --cov=src/soar_lab --cov-report=html --cov-report=xml --cov-report=term
	-@docker exec soar_api cp -r /app/htmlcov /app/results/ 2>nul
	-@docker exec soar_api cp /app/coverage.xml /app/results/ 2>nul

# Maintenance
deps:
	@echo "Installing Python dependencies..."
	pip install -r requirements.txt

deps-test:
	@echo "Installing test dependencies..."
	pip install -r requirements-test.txt

generate-secrets:
	@echo "Generating secure passwords/tokens..."
	@python src/soar_lab/scripts/setup/generate_secrets.py

certs:
	@echo "Generating TLS certificates for Nginx..."
	python3 src/soar_lab/infrastructure/generate_certs.py

check-deps:
	@echo "Verifying all dependencies are installed..."
	python3 src/soar_lab/infrastructure/check_deps.py

# Cleanup
clean:
	@echo "Cleaning temporary files..."
	powershell -Command "if (Test-Path artifacts\results) { Remove-Item -Recurse -Force artifacts\results }"
	powershell -Command "if (Test-Path artifacts\coverage) { Remove-Item -Recurse -Force artifacts\coverage }"
	powershell -Command "if (Test-Path artifacts\logs\*.log) { Remove-Item -Force artifacts\logs\*.log }"

clean-full:
	@echo "Full cleanup: removing all artifacts..."
	powershell -Command "if (Test-Path artifacts) { Remove-Item -Recurse -Force artifacts }"

clean-all: clean-full
	@echo "Cleaning all: artifacts + Docker resources..."
	-$(DC) down -v --remove-orphans
	-powershell -Command "docker ps -aq --filter name=soar_ | ForEach-Object { docker rm -f $$_ } 2>$$null"
	-powershell -Command "docker volume ls -q | Where-Object { $$_ -match '^soar' -or $$_ -match '^soar-lab' } | ForEach-Object { docker volume rm $$_ } 2>$$null"
	-powershell -Command "docker network ls --format '{{.Name}}' | Where-Object { $$_ -match 'soar' -or $$_ -eq 'logging_net' -or $$_ -eq 'ti_net' } | ForEach-Object { docker network rm $$_ } 2>$$null"

clean-docker:
	@echo "Cleaning Docker resources only..."
	-$(DC) down -v --remove-orphans
	-powershell -Command "docker ps -aq --filter name=soar_ | ForEach-Object { docker rm -f $$_ } 2>$$null"
	-powershell -Command "docker volume ls -q | Where-Object { $$_ -match '^soar' -or $$_ -match '^soar-lab' } | ForEach-Object { docker volume rm $$_ } 2>$$null"
	-powershell -Command "docker network ls --format '{{.Name}}' | Where-Object { $$_ -match 'soar' -or $$_ -eq 'logging_net' -or $$_ -eq 'ti_net' } | ForEach-Object { docker network rm $$_ } 2>$$null"
