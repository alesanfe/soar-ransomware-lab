# Pin recipe shell to cmd.exe: GNU Make picks sh.exe when it is on PATH, and
# this Makefile's recipes use cmd syntax (`>nul`, `findstr`, `if not exist`).
# Without this pin, running `make` from Git Bash/MSYS2 broke `make up` (the
# inline `python -c` escaping changed under sh). Python logic now lives in
# scripts/setup/*.py so recipes stay shell-agnostic, but the pin keeps the
# remaining cmd idioms deterministic on every Windows host.
SHELL := cmd.exe

PROJECT  := soar
COMPOSE_FILES := -f infra/docker/compose/docker-compose.yml \
                 -f infra/docker/compose/docker-compose.core.yml \
                 -f infra/docker/compose/docker-compose.misp.yml \
                 -f infra/docker/compose/docker-compose.opensearch.yml \
                 -f infra/docker/compose/docker-compose.api.yml \
                 -f infra/docker/compose/logging/docker-compose.logging.yml
# Secure-by-default (DK-P0-001): `make up` always composes the hardened
# overlay. The relaxed lab topology (API as root, RW docker socket, optional
# auth) requires an explicit opt-out: `make up-lab` or `make up LAB=1`.
ifneq ($(LAB),1)
COMPOSE_FILES += -f infra/docker/compose/docker-compose.hardened.yml
endif
export RUNTIME_DIR := $(CURDIR)/runtime
export REPORTS_DIR := $(CURDIR)/reports
DC := docker compose -p $(PROJECT) $(COMPOSE_FILES) --env-file .env

