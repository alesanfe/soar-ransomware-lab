
PROJECT  := soar
COMPOSE_FILES := -f infra/docker/compose/docker-compose.yml \
                 -f infra/docker/compose/docker-compose.core.yml \
                 -f infra/docker/compose/docker-compose.misp.yml \
                 -f infra/docker/compose/docker-compose.opensearch.yml \
                 -f infra/docker/compose/docker-compose.api.yml \
                 -f infra/docker/compose/logging/docker-compose.logging.yml
export RUNTIME_DIR := $(CURDIR)/runtime
export REPORTS_DIR := $(CURDIR)/reports
DC := docker compose -p $(PROJECT) $(COMPOSE_FILES) --env-file .env

.PHONY: help install install-dev
.PHONY: up down restart logs ps health
.PHONY: test-unit test-integration test-e2e test-atomic test-smoke test-security test-performance test-all test-coverage test-docker-runtime
