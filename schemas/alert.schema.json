{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Alert Schema",
  "description": "Schema for security alerts in SOAR Ransomware Lab",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for the alert"
    },
    "alert_type": {
      "type": "string",
      "enum": ["ransomware", "malware", "benign", "suspicious"],
      "description": "Type of alert"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Severity level of the alert"
    },
    "hostname": {
      "type": "string",
      "description": "Hostname where the alert was detected"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert was generated"
    },
    "data": {
      "type": "object",
      "description": "Additional alert data"
    },
    "source": {
      "type": "string",
      "description": "Source of the alert"
    }
  },
  "required": ["alert_id", "alert_type", "severity", "hostname", "timestamp"],
  "additionalProperties": false
}
