[flake8]
max-line-length = 100
extend-ignore =
    E203, W503,
    D100, D101, D102, D103, D104, D105, D107,
    D200, D202, D205, D209, D301, D400, D401, D402, D403,
    ANN001, ANN002, ANN003, ANN101, ANN102, ANN201, ANN202, ANN204, ANN205, ANN206,
    Q000, Q001, Q002, Q003,
    S101, S105, S106, S501, S603, S607, S608, S404, S108, S311, S104, S110, S112, S113,
    DCO010, DCO020, DCO023, DCO030, DCO050, DCO051, DCO053, DCO054, DCO055, DCO060, DCO063,
    DAR101, DAR201, DAR203, DAR301, DAR401, DAR402, DAR003,
    WPS,
    FNE001, FNE002, FNE003, FNE004, FNE005, FNE007, FNE008,
    VNE001, VNE002, VNE003,
    C812, C813, C815, C816,
    PIE781, PIE786, PIE798, PIE799, PIE801, PIE803,
    R100, R503, R504, R505, R701,
    B007, B014, B017, B023, B026, B036, B042, B043, B008,
    T001, T002, T003, T100, T101, T102, T201,
    C101, C401, C420, CM001,
    ISC001, ISC002, ISC003, ISC004,
    P101, P102, P103,
    UP031,
    F501, F502, F503, F504, F505, F506, F507, F508, F509, F510, F511, F512, F521, F541,
    M511,
    N400,
    L101, L102, L103,
    INP001,
    TID251, TID252, TID253,
    TC001, TC002, TC003,
    FA100, FA101,
    PT001, PT002, PT003, PT004, PT006, PT007, PT008, PT009, PT011, PT012, PT017, PT018, PT022,
    E800,
    CCE001,
    CCR001,
    ECE001,
    G001, G002, G003, G004, G200, G201, G202,
    PTH,
    SCS,
    SIM,
    TRY002, TRY003, TRY004, TRY101, TRY200, TRY202, TRY300, TRY301, TRY400,
    DUO102, DUO122, DUO123, DUO131,
    PD002, PD003, PD004, PD005, PD007, PD008, PD009, PD010, PD011, PD012, PD013, PD015,
    H101, H104, H301, H306, H403, H404, H405, H601,
    DOC301, DOC302, DOC402, DOC501, DOC502,
    BLK100,
    CFQ001, CFQ002, CFQ004,
    E402, W391, W293,
    DTZ001, DTZ003, DTZ005, DTZ006, DTZ007,
    SIM102, SIM105, SIM111, SIM113, SIM114, SIM117, SIM901, SIM910,
    PL100, PL106, PL108, PL110, PL112, PL113, PL118, PL123,
    FMT102, FMT103,
    LN001, LN002,
    TYP001,
    A001, A002, A003, A004, A005, ASN001,
    FNE, WPS, SCS, SIM, PTH, DAR, DCO, DOC, CFQ, CCE, CCR, ECE, BLK, FMT, LN, TYP
per-file-ignores =
    tests/*:S101,S105,S106,S110,S311,S404,S603,S607,T201,D100,D101,D102,D103,D104,D105,D107,ANN,E712,E501
    scripts/*:T201,T101,T102,LOG015,S110,S603,S607,S404,S108
    scripts/setup/*:S603,S607,S404,S108,T201,LOG015
    tests/conftest.py:S101,D100,D101,D102,D103,D104
    */__init__.py:D104,F401,F403
    src/soar_lab/infrastructure/network_watcher/*:S104,S603,S607,S110
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .tox,
    .venv,
    venv,
    apps/docs-site/build,
    apps/docs-site/node_modules,
    reports,
    runtime,
    artifacts,
    _*.py,
    _deep_sim.py,
    _analyze*.py,
    _check_*.py,
    _compare_*.py,
    _find_*.py,
    _add_*.py,
    src/soar_lab/scripts/__init__.py
